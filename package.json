{
  "name": "pathway",
  "version": "2.2.1",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @pathway/web dev",
    "dev:admin": "pnpm --filter @pathway/admin dev",
    "dev:api": "pnpm --filter @pathway/api dev",
    "dev:apps": "pnpm dev:web & pnpm dev:admin & pnpm dev:api",
    "dev:proxy": "caddy run --config Caddyfile.dev",
    "dev:all": "pnpm dev:apps & pnpm dev:proxy",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down -v",
    "prepare": "husky",
    "infra:ps": "docker compose -f infra/docker/docker-compose.yml ps",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @pathway/db run prisma:generate",
    "db:migrate": "pnpm --filter @pathway/db run prisma:migrate:dev",
    "db:deploy": "pnpm --filter @pathway/db run prisma:migrate:deploy",
    "db:status:production": "node scripts/prisma-production.mjs status",
    "db:deploy:production": "node scripts/prisma-production.mjs deploy",
    "db:reset": "pnpm --filter @pathway/db run prisma:migrate:reset",
    "db:seed": "pnpm --filter @pathway/db run seed",
    "env:production:prepare": "node scripts/prepare-production-env.mjs",
    "launch:preflight": "node scripts/launch-preflight.mjs",
    "supabase:rls:check": "node scripts/check-supabase-rls.mjs",
    "vercel:projects:setup": "node scripts/setup-vercel-projects.mjs",
    "vercel:env:sync": "node scripts/sync-vercel-env.mjs",
    "vercel:deploy:production": "node scripts/deploy-vercel-production.mjs",
    "github:secrets:setup": "node scripts/setup-github-actions-secrets.mjs",
    "cert:api": "mkdir -p .cert && mkcert -cert-file .cert/api.localhost.pem -key-file .cert/api.localhost-key.pem localhost 127.0.0.1 ::1 api.localhost",
    "reset": "git restore apps/**/.turbo/*.log packages/**/.turbo/*.log",
    "clean:cache": "git clean -fdX .turbo",
    "clean:all": "rm -rf node_modules .turbo && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.35.0",
    "@jest/test-sequencer": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.34.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "turbo": "^2.0.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.43.0"
  },
  "dependencies": {
    "@pathway/db": "workspace:*",
    "@pathway/pricing": "workspace:*",
    "resend": "^6.6.0"
  }
}
