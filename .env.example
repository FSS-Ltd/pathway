# ---- Global ----
NODE_ENV=development

# ---- Database (Docker) ----
# Local Postgres exposed on 5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pathway?schema=public
# Production on Vercel should use Supabase transaction pooler for DATABASE_URL
# and a direct/session URL for migration workflows.
# DIRECT_URL=postgresql://postgres:postgres@localhost:5433/pathway?schema=public
# Required only by pnpm db:seed. This separate credential must authenticate as
# pathway_system_role_seed and must never be exposed to runtime application services.
# SYSTEM_ROLE_SEED_DATABASE_URL=postgresql://pathway_system_role_seed:replace-me@localhost:5433/pathway?schema=app

# ---- Redis (Docker) ----
REDIS_URL=redis://localhost:6380

# ---- App Ports / URLs ----
API_PORT=3001
API_BIND_HOST=0.0.0.0
API_ENABLE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://app.localhost:3000,https://api.localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Google Analytics Measurement ID for marketing site (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Admin app URL (for invite links). Dev: https://app.localhost:3000, Prod: https://app.nexsteps.dev
# ADMIN_URL=https://app.localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3001
# Marketing site URL (for toolkit download links). Default: http://localhost:3001
# SITE_URL=https://nexsteps.dev
# Parent signup link base URL (for QR code). Auto: localhost in dev, nexsteps.dev in prod.
# PUBLIC_WEB_BASE_URL=https://www.localhost:3000
# Internal API URL for server-side fetches (avoids TLS issues with self-signed certs in dev).
# Use HTTP (e.g. http://localhost:3001) when API runs over HTTPS with self-signed cert.
# ADMIN_INTERNAL_API_URL=http://localhost:3001
# API_INTERNAL_URL=http://localhost:3001
# Production custom domains:
# NEXT_PUBLIC_API_URL=https://api.nexsteps.dev
# ADMIN_INTERNAL_API_URL=https://api.nexsteps.dev
# API_INTERNAL_URL=https://api.nexsteps.dev
# NEXT_PUBLIC_SITE_URL=https://nexsteps.dev
# PUBLIC_BLOG_BASE_URL=https://nexsteps.dev
# WEB_APP_URL=https://nexsteps.dev
# Shared secret used by the API to trigger web/admin revalidation endpoints.
# REVALIDATE_SECRET=generate-a-long-random-value
# Toolkit token expiry in hours. Default: 48
# TOOLKIT_TOKEN_TTL_HOURS=48
# If the API runs over HTTPS with a self-signed cert (e.g. api.localhost), the admin
# auth callback may fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE. Use HTTP above, or in
# dev only: NODE_TLS_REJECT_UNAUTHORIZED=0 (never in production).

# ---- Email (Resend) ----
# RESEND_API_KEY=re_xxx
# RESEND_FROM must be: email@domain.com OR "Name <email@domain.com>"
# Example: RESEND_FROM=Nexsteps <noreply@mail.nexsteps.dev>
# Optional until Resend webhooks are enabled.
# RESEND_WEBHOOK_SECRET=whsec_xxx
# Use a verified domain in Resend dashboard for production.

# ---- Supabase Storage (server-side only) ----
# Keep SUPABASE_SECRET_KEY out of browser/mobile env. It belongs only in API/worker secrets.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_STORAGE_PRIVATE_BUCKET=pathway-private
# SUPABASE_STORAGE_PUBLIC_BUCKET=pathway-public
# Launch preflight override. Set true only after public schema Data API exposure
# has been removed or table-specific RLS policies have been approved.
# SUPABASE_RLS_GATE_ACCEPTED=false

# ---- Auth (placeholder; fill later) ----
# AUTH0_DOMAIN=
# AUTH0_ISSUER=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=
# NEXTAUTH_URL=https://app.nexsteps.dev
# NEXTAUTH_SECRET=
# INTERNAL_AUTH_SECRET=
# For existing-user signup (password verify on form): enable "Password" grant in Auth0 Dashboard.

# ---- PII field encryption (packages/util/src/crypto.ts) ----
# Base64-encoded 256-bit (32 byte) key used to encrypt sensitive PII columns at rest
# (child medical/SEND notes, guardian contact details, safeguarding text). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by re-encrypting via `pnpm --filter @pathway/api pii:backfill -- --apply` under the new key.
# PII_ENCRYPTION_KEY=

# ---- Billing (Stripe placeholders; never commit real values) ----
# BILLING_PROVIDER=STRIPE_TEST
# STRIPE_SECRET_KEY=
# STRIPE_SECRET_KEY_TEST=
# STRIPE_WEBHOOK_SECRET_SNAPSHOT=
# STRIPE_WEBHOOK_SECRET_THIN=
# STRIPE_WEBHOOK_SECRET_TEST=
# STRIPE_PRICE_MAP={}
# STRIPE_PRICE_MAP_TEST={}
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SUCCESS_URL=https://app.nexsteps.dev/admin/billing/success
# STRIPE_CANCEL_URL=https://app.nexsteps.dev/admin/billing

# ---- Scheduled workers ----
# Optional. If omitted, scheduled AV30 computation is a no-op until tenant IDs exist.
# AV30_TENANT_IDS=tenant-id-1,tenant-id-2
# RETENTION_ENABLED=true
# Gate for the hourly guest-pass-cleanup worker (apps/workers/src/guest-pass).
# GUEST_CLEANUP_ENABLED=true

# ---- Vercel deployment automation ----
# Required in GitHub Actions production environment secrets:
# pnpm github:secrets:setup
# VERCEL_TOKEN=
# VERCEL_ORG_ID=team_qvufVWPpOoZtQcAtRv8KQenE
# VERCEL_WEB_PROJECT_ID=
# VERCEL_ADMIN_PROJECT_ID=
# VERCEL_API_PROJECT_ID=
# Optional project name overrides for pnpm vercel:projects:setup
# VERCEL_WEB_PROJECT_NAME=nexsteps-web
# VERCEL_ADMIN_PROJECT_NAME=nexsteps-admin
# VERCEL_API_PROJECT_NAME=nexsteps-api
