{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pathway/web", "exec", "next", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pathway/admin", "exec", "next", "dev", "-p", "3002"],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "nexsteps-home",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pathway/nexsteps-home", "exec", "expo", "start", "--web"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
