  subject          Subject                        @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  startsOn         DateTime                       @db.Date
  endsOn           DateTime?                      @db.Date
  status           StudentSubjectEnrollmentStatus @default(ACTIVE)
  startingPace     Int
  currentPace      Int
  targetPace       Int
  recordedByUserId String
  recordedBy       User                           @relation("StudentSubjectEnrollmentRecordedBy", fields: [recordedByUserId], references: [id])
  diagnosticResults PaceDiagnosticResult[]
  reason           String                         @db.Text
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId])
  @@index([tenantId, status, subjectId, childId])
}

// Append-only diagnostic facts. A retraction is a separate fact; recording
// never changes the enrolled PACE or assessment progress.
model PaceDiagnosticResult {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  childId          String
  child            Child                 @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subjectId        String
  subject          Subject               @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enrollmentId     String
  enrollment       StudentSubjectEnrollment @relation(fields: [enrollmentId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict)
  level            Int
  outcome          PaceDiagnosticOutcome
  recordedByUserId String
  recordedBy       User                  @relation("PaceDiagnosticResultRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  recordedAt       DateTime              @default(now())
  retraction       PaceDiagnosticRetraction?

  @@unique([id, tenantId])
  @@index([tenantId, childId, subjectId, recordedAt, id])
}

model PaceDiagnosticRetraction {
  id                String                @id @default(uuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resultId          String
  result            PaceDiagnosticResult  @relation(fields: [resultId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reason            String                @db.Text
  retractedByUserId String
  retractedBy       User                  @relation("PaceDiagnosticRetractionRecordedBy", fields: [retractedByUserId], references: [id], onDelete: Restrict)
  retractedAt       DateTime              @default(now())

  @@unique([id, tenantId])
  @@unique([resultId, tenantId])
  @@index([tenantId, retractedAt, id])
}

// Immutable assessment facts. Corrections are complete successor facts linked
// to the immediately preceding fact; database constraints prevent forks.
model PaceAssessment {
  id                    String               @id @default(uuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  childId               String
  child                 Child                @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId             String
  subject               Subject              @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  paceNumber            Int
  assessmentType        PaceAssessmentType
  score                 Int
  result                PaceAssessmentResult
  assessedOn            DateTime             @db.Date
  recordedByUserId      String
  recordedBy            User                 @relation("PaceAssessmentRecordedBy", fields: [recordedByUserId], references: [id])
  reason                String               @db.Text
  policyOverrideId      String?
  policyOverride        PacePolicyOverride?  @relation(fields: [policyOverrideId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict)
  correctsAssessmentId  String?
  correctsAssessment    PaceAssessment?      @relation("PaceAssessmentCorrections", fields: [correctsAssessmentId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict, onUpdate: Restrict, map: "PaceAssessment_correction_target_fkey")
  correction            PaceAssessment?      @relation("PaceAssessmentCorrections")
  progressUsingAsLatest PaceProgress[]
  createdAt             DateTime             @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId])
  @@unique([correctsAssessmentId, tenantId, childId, subjectId], map: "PaceAssessment_correction_target_key")
  @@unique([policyOverrideId, tenantId])
  @@index([tenantId, childId, subjectId, assessedOn])
  @@index([tenantId, correctsAssessmentId])
}

// Mutable, disposable projection rebuilt from the current (not superseded)
// PaceAssessment facts.
model PaceProgress {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  childId          String
  child            Child           @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId        String
  subject          Subject         @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  currentPace      Int
  targetPace       Int
  completedPaces   Int             @default(0)
  trackStatus      PaceTrackStatus
  blockCode        String?
  lastAssessmentId String?
  lastAssessment   PaceAssessment? @relation(fields: [lastAssessmentId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict)
  rebuiltAt        DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, childId, subjectId])
  @@index([tenantId, childId])
  @@index([tenantId, trackStatus])
}

model PaceInventoryOrder {
  id              String                   @id @default(uuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  childId         String
  child           Child                    @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subjectId       String
  subject         Subject                  @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paceNumber      Int
  status          PaceInventoryOrderStatus @default(ORDERED)
  orderedAt       DateTime                 @default(now())
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  createdByUserId String
  createdBy       User                     @relation("PaceInventoryOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  supply          PaceInventorySupply?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId, paceNumber])
  @@index([tenantId, childId, subjectId, status, paceNumber])
  @@index([tenantId, status, createdAt])
}

model PaceInventorySupply {
  id              String                    @id @default(uuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  childId         String
  child           Child                     @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subjectId       String
  subject         Subject                   @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paceNumber      Int
  source          PaceInventorySupplySource
  sourceOrderId   String?
  sourceOrder     PaceInventoryOrder?       @relation(fields: [sourceOrderId, tenantId, childId, subjectId, paceNumber], references: [id, tenantId, childId, subjectId, paceNumber], onDelete: Restrict)
  createdByUserId String
  createdBy       User                      @relation("PaceInventorySupplyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())

  @@unique([tenantId, childId, subjectId, paceNumber])
  @@unique([sourceOrderId, tenantId, childId, subjectId, paceNumber])
  @@index([tenantId, childId, subjectId])
}

// Append-only policy versions. The effective version is selected by time.
model PacePolicy {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  version              Int
  selfTestPassingScore Int
  paceTestPassingScore Int
  maxAssessmentsPerDay Int
  allowSamePaceSameDay Boolean              @default(false)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  createdByUserId      String
  createdBy            User                 @relation("PacePolicyCreatedBy", fields: [createdByUserId], references: [id])
  reason               String               @db.Text
  overrides            PacePolicyOverride[]
  createdAt            DateTime             @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
}

model PacePolicyOverride {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  childId            String
  child              Child            @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId          String
  subject            Subject          @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  pacePolicyId       String
  pacePolicy         PacePolicy       @relation(fields: [pacePolicyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  policyCode         String
  clientCommandKeyHash  String?
  assessmentFingerprint String?
  authorisedByUserId String
  authorisedBy       User             @relation("PacePolicyOverrideAuthorisedBy", fields: [authorisedByUserId], references: [id])
  reason             String           @db.Text
  expiresAt          DateTime // PostgreSQL also rejects non-finite timestamps.
  assessments        PaceAssessment[]
  createdAt          DateTime         @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId])
  @@unique([tenantId, clientCommandKeyHash], map: "PacePolicyOverride_tenant_client_command_key")
  @@index([tenantId, childId, expiresAt])
  @@index([tenantId, subjectId, expiresAt])
}

// Immutable category snapshots. A site's current configuration is the highest
// policyVersion, so inactive categories remain available for historic entries.
model BehaviourCategory {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  policyVersion   Int
  code            String
  label           String
  type            BehaviourType
  visibility      BehaviourVisibility @default(GENERAL)
  isActive        Boolean             @default(true)
  isSerious       Boolean             @default(false)
  sortOrder       Int
  createdByUserId String
  createdBy       User                @relation("BehaviourCategoryCreatedBy", fields: [createdByUserId], references: [id])
  reason          String              @db.Text
  createdAt       DateTime            @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, policyVersion, code])
  @@unique([tenantId, policyVersion, sortOrder])
  @@index([tenantId, policyVersion, sortOrder])
}

// note is sensitive free text encrypted transparently by packages/db/src/pii-encryption.ts.
// Corrections use the same complete-fact successor pattern as PaceAssessment.
model BehaviourEntry {
  id                       String              @id @default(uuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id])
  childId                  String
  child                    Child               @relation(fields: [childId, tenantId], references: [id, tenantId])
  type                     BehaviourType
  visibility               BehaviourVisibility @default(GENERAL)
  category                 String
  categoryPolicyVersion    Int?
  categoryIsSerious        Boolean?
  pointsDelta              Int                 @default(0)
  occurredAt               DateTime
  recordedByUserId         String
  recordedBy               User                @relation("BehaviourEntryRecordedBy", fields: [recordedByUserId], references: [id])
  reason                   String              @db.Text
  note                     String?             @db.Text
  correctsBehaviourEntryId String?
  clientCommandKeyHash     String?
  commandFingerprint       String?
  correctsBehaviourEntry   BehaviourEntry?     @relation("BehaviourEntryCorrections", fields: [correctsBehaviourEntryId, tenantId, childId], references: [id, tenantId, childId], onDelete: Restrict, onUpdate: Restrict, map: "BehaviourEntry_correction_target_fkey")
  correction               BehaviourEntry?     @relation("BehaviourEntryCorrections")
  createdAt                DateTime            @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId])
  @@unique([correctsBehaviourEntryId, tenantId, childId], map: "BehaviourEntry_correction_target_key")
  @@unique([tenantId, clientCommandKeyHash], map: "BehaviourEntry_tenant_client_command_key")
  @@index([tenantId, childId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, correctsBehaviourEntryId])
}

model DemeritPolicy {
  id                     String                 @id @default(uuid())
  tenantId               String
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  version                Int
  windowDays             Int
  stageOneThreshold      Int
  stageTwoThreshold      Int
  stageThreeThreshold    Int
  seriousMisconductStage Int
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  createdByUserId        String
  createdBy              User                   @relation("DemeritPolicyCreatedBy", fields: [createdByUserId], references: [id])
  reason                 String                 @db.Text
  stageOverrides         DemeritStageOverride[]
  createdAt              DateTime               @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
}

model DemeritStageOverride {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  childId            String
  child              Child         @relation(fields: [childId, tenantId], references: [id, tenantId])
  demeritPolicyId    String
  demeritPolicy      DemeritPolicy @relation(fields: [demeritPolicyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stage              Int
  authorisedByUserId String
  authorisedBy       User          @relation("DemeritStageOverrideAuthorisedBy", fields: [authorisedByUserId], references: [id])
  reason             String        @db.Text
  expiresAt          DateTime // PostgreSQL also rejects non-finite timestamps.
  createdAt          DateTime      @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, childId, expiresAt])
}

model LearningLog {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  childId        String
  child          Child      @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId      String?
  subject        Subject?   @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  loggedByUserId String
  loggedBy       User       @relation("LearningLogLoggedBy", fields: [loggedByUserId], references: [id])
  activityDate   DateTime   @db.Date
  minutes        Int?
  title          String
  description    String?    @db.Text
  // NexSteps Home: the planned Activity this log completes, if any. Nullable -
  // every other vertical logs without a planned activity, and still can.
  activityId     String?
  activity       Activity?  @relation(fields: [activityId, tenantId], references: [id, tenantId])
  evidence       Evidence[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, activityDate])
  @@index([tenantId, childId, activityDate])
  @@index([subjectId])
  @@index([activityId])
}

// NexSteps Home week/today planning (H3). A planned learning activity for one
// child; subjectIds is a loose tag list (not a DB relation - validated
// against Subject at the service layer) since a household activity can span
// multiple subjects, unlike LearningLog's single subjectId.
model Activity {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  childId         String
  child           Child         @relation(fields: [childId, tenantId], references: [id, tenantId])
  title           String
  scheduledAt     DateTime
  durationMinutes Int?
  subjectIds      String[]      @default([])
  planNotes       String?       @db.Text
  resourcesNote   String?       @db.Text
  createdByUserId String
  createdBy       User          @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id])
  learningLogs    LearningLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, scheduledAt])
  @@index([tenantId, childId, scheduledAt])
  @@unique([id, tenantId])
}

// NexSteps Home week/today planning (H3). A household task, distinct from a
// learning Activity - "renew library books", not learning itself.
model Task {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  title            String
  assignedToUserId String?
  assignedTo       User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  dueAt            DateTime?
  priority         TaskPriority @default(NORMAL)
  completedAt      DateTime?
  createdByUserId  String
  createdBy        User         @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  correspondence   Correspondence[]

  @@unique([id, tenantId])
  @@index([tenantId, dueAt])
  @@index([tenantId, completedAt])
}

// NexSteps Home week/today planning (H3). A private family calendar item
// (an appointment, a visit) - never exposed to Community, by design; not a
// per-item flag, an architectural invariant of this model.
model CalendarItem {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  title           String
  who             String?
  scheduledAt     DateTime
  location        String?
  createdByUserId String
  createdBy       User     @relation("CalendarItemCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, scheduledAt])
}

model Evidence {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  childId          String
  child            Child        @relation(fields: [childId, tenantId], references: [id, tenantId])
  learningLogId    String?
  learningLog      LearningLog? @relation(fields: [learningLogId, tenantId], references: [id, tenantId])
  title            String
  storageKey       String
  mimeType         String
  byteSize         Int
  capturedAt       DateTime?
  uploadedByUserId String
  uploadedBy       User         @relation("EvidenceUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime     @default(now())
  regulationEvidenceLinks  EvidenceLink[]
  correspondenceOriginals  Correspondence[] @relation("CorrespondenceOriginal")

  @@unique([id, tenantId])
  @@index([tenantId, childId])
  @@index([learningLogId])
}

model ReportBundle {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  childId           String?
  child             Child?             @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User               @relation("ReportBundleRequestedBy", fields: [requestedByUserId], references: [id])
  periodStart       DateTime           @db.Date
  periodEnd         DateTime           @db.Date
  status            ReportBundleStatus @default(PENDING)
  storageKey        String?
  failureReason     String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([tenantId, childId])
  @@index([status])
}

// NexSteps Home privacy & data (Plan 08e): synchronous household export
// requests (see PrivacyService.requestExport - no worker/queue, mirrors
// ReportBundle/createReportBundle's own documented reasoning).
model DataExportRequest {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  requestedById String
  requestedBy   User             @relation("DataExportRequestRequestedBy", fields: [requestedById], references: [id])
  kind          DataExportKind
  status        DataExportStatus @default(PENDING)
  storageKey    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, kind, createdAt])
}

// NexSteps Home privacy & data (Plan 08e): support-routed "delete family
// account" request - files a request for support to action, does not
// delete anything itself.
model AccountDeletionRequest {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  requestedById String
  requestedBy   User     @relation("AccountDeletionRequestRequestedBy", fields: [requestedById], references: [id])
  reason        String?
  status        String   @default("SUBMITTED") // SUBMITTED | IN_REVIEW | COMPLETED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, createdAt])
}

model Announcement {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([publishedAt])
  @@index([tenantId, audience, publishedAt])
}

// text is encrypted at rest — see packages/db/src/pii-encryption.ts.
model ChildNote {
  id               String    @id @default(uuid())
  childId          String
  child            Child     @relation(fields: [childId], references: [id])
  authorId         String
  author           User      @relation("ChildNoteAuthor", fields: [authorId], references: [id])
  text             String
  visibleToParents Boolean   @default(false)
  approvedByUserId String?
  approvedBy       User?     @relation("ChildNoteApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([childId])
  @@index([authorId])
}

model AuditEvent {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now())
  tenantId    String?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id])
  orgId       String
  org         Org             @relation(fields: [orgId], references: [id])
  actorUserId String
  actor       User            @relation("AuditActor", fields: [actorUserId], references: [id])
  entityType  AuditEntityType
  entityId    String?
  action      AuditAction
  metadata    Json?

  @@index([tenantId, createdAt])
  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

// --- Billing & Entitlements ---

model Subscription {
  id                String             @id @default(uuid())
  orgId             String
  org               Org                @relation(fields: [orgId], references: [id])
  provider          BillingProvider
  providerSubId     String             @unique
  planCode          String
  status            SubscriptionStatus
  periodStart       DateTime
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orgId])
  @@index([status])
  @@index([planCode])
}

model OrgEntitlementSnapshot {
  id                  String   @id @default(uuid())
  orgId               String
  org                 Org      @relation(fields: [orgId], references: [id])
  maxSites            Int
  av30Included        Int
  leaderSeatsIncluded Int
  storageGbIncluded   Int
  flagsJson           Json?
  source              String // e.g., trial, subscription(pro), manual_override
  createdAt           DateTime @default(now())

  @@index([orgId, createdAt])
}

model UsageCounters {
  id           String   @id @default(uuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  av30         Int      @default(0)
  storageGb    Int      @default(0)
  smsMonth     Int      @default(0)
  exportsMonth Int      @default(0)
  calculatedAt DateTime @default(now())

  @@index([orgId, calculatedAt])
}

model BillingEvent {
  id          String          @id @default(uuid())
  orgId       String?
  org         Org?            @relation(fields: [orgId], references: [id])
  provider    BillingProvider
  type        String
  payloadJson Json
  createdAt   DateTime        @default(now())

  @@index([orgId, createdAt])
}

model PendingOrder {
  id                     String             @id @default(uuid())
  tenantId               String?
  tenant                 Tenant?            @relation(fields: [tenantId], references: [id])
  orgId                  String?
  org                    Org?               @relation(fields: [orgId], references: [id])
  planCode               String
  av30Cap                Int?
  storageGbCap           Int?
  smsMessagesCap         Int?
  leaderSeatsIncluded    Int?
  maxSites               Int?
  selectedModules        Module[]           @default([])
  flags                  Json?
  warnings               Json?
  provider               BillingProvider
  providerCheckoutId     String?
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 PendingOrderStatus @default(PENDING)
  createdAt              DateTime           @default(now())
  completedAt            DateTime?
  updatedAt              DateTime           @updatedAt

  // For public checkout: store org/user details until payment confirmed.
  // Encrypted as a whole (may carry a plaintext password transiently) — see
  // packages/db/src/pii-encryption.ts. { orgName, slug, contactName, contactEmail, password }
  pendingOrgDetails Json?

  @@index([tenantId, orgId, provider, providerCheckoutId])
  @@index([provider, providerSubscriptionId])
}

model OrgRetentionPolicy {
  id                         String   @id @default(uuid())
  orgId                      String   @unique
  org                        Org      @relation(fields: [orgId], references: [id])
  attendanceRetentionDays    Int
  staffActivityRetentionDays Int
  auditEventRetentionDays    Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model StaffActivity {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  staffUserId  String
  staffUser    User     @relation(fields: [staffUserId], references: [id])
  activityType String // Av30ActivityType enum value
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, staffUserId, occurredAt])
  @@index([orgId, occurredAt])
  @@index([orgId, staffUserId, occurredAt])
}

model Lead {
  id             String          @id @default(uuid())
  kind           LeadKind
  email          String
  name           String?
  organisation   String?
  role           String?
  sector         String?
  message        String?         @db.Text
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  metadataJson   Json?
  downloadedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  downloadTokens DownloadToken[]

  @@index([email, kind, createdAt])
  @@index([kind, createdAt])
}

model DownloadToken {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tokenHash])
  @@index([tokenHash])
  @@index([leadId])
}

// Idempotency ledger for identity-provider webhooks (Clerk). The id is the
// provider's event id (e.g. Svix svix-id) - inserting it is the dedup check.
// Also doubles as the processing audit trail for these events.
model IdentityWebhookEvent {
  id         String   @id
  provider   String
  eventType  String
  status     String
  receivedAt DateTime @default(now())

  @@index([provider, eventType])
}

// --- NexSteps Home Regulations & Evidence (H6/Plan 09) ---
// 5 global reference tables (no tenantId, globally readable content, no
// runtime writer in this sub-plan) + 3 tenant-owned tables. See
// packages/db/prisma/migrations/20260810090000_add_regulations_foundation
// for the RLS/CHECK-constraint treatment this schema does not model.

model Jurisdiction {
  id                   String                    @id @default(uuid())
  countryCode          String                    @db.Char(2) // ISO 3166-1 alpha-2
  subdivisionCode      String? // ISO 3166-2, null at COUNTRY level
  name                 String
  level                JurisdictionLevel
  parentJurisdictionId String?
  parent               Jurisdiction?             @relation("JurisdictionTree", fields: [parentJurisdictionId], references: [id], onDelete: Restrict)
  children             Jurisdiction[]            @relation("JurisdictionTree")
  contentStatus        JurisdictionContentStatus @default(NOT_CONFIGURED)
  authorities          RegulatoryAuthority[]
  requirements         Requirement[]
  householdRequirements HouseholdRequirement[]
  tenantsAsNation          Tenant[]               @relation("HouseholdNation")
  tenantsAsLocalAuthority  Tenant[]               @relation("HouseholdLocalAuthority")

  @@index([countryCode, subdivisionCode])
  @@index([parentJurisdictionId])
  @@index([level, contentStatus])
}

model RegulatoryAuthority {
  id             String                  @id @default(uuid())
  jurisdictionId String
  jurisdiction   Jurisdiction            @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  name           String
  authorityType  RegulatoryAuthorityType
  officialDomain String
  sources        RegulatorySource[]
  correspondence Correspondence[]

  @@index([jurisdictionId])
}

model RegulatorySource {
  id                String                  @id @default(uuid())
  authorityId       String
  authority         RegulatoryAuthority     @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  title             String
  canonicalUrl      String
  sourceType        RegulatorySourceType
  publishedAt       DateTime?
  effectiveAt       DateTime?
  lastCheckedAt     DateTime?
  lastVerifiedAt    DateTime?
  verifiedByUserId  String?
  reviewWindowDays  Int                     @default(90)
  verificationState SourceVerificationState @default(UNVERIFIED)
  contentHash       String?
  requirementVersions RequirementVersion[]

  @@index([authorityId])
  @@index([verificationState, lastVerifiedAt])
}

model Requirement {
  id             String               @id @default(uuid())
  jurisdictionId String
  jurisdiction   Jurisdiction         @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  sortOrder      Int                  @default(0)
  versions       RequirementVersion[]
  householdRequirements HouseholdRequirement[]

  @@index([jurisdictionId, sortOrder])
}

model RequirementVersion {
  id                     String                   @id @default(uuid())
  requirementId          String
  requirement            Requirement              @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  versionNumber          Int
  status                 RequirementVersionStatus @default(DRAFT)
  title                  String
  summary                String                   @db.Text
  preparationSuggestions String[]                 @default([])
  appliesTo              RequirementAppliesTo     @default(HOUSEHOLD)
  applicabilityNote      String?                  @db.Text
  primarySourceId        String
  primarySource          RegulatorySource         @relation(fields: [primarySourceId], references: [id], onDelete: Restrict)
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  impactLevel            RequirementImpactLevel   @default(ROUTINE)
  changeKind             RequirementChangeKind    @default(NEW)
  changeSummary          String?                  @db.Text
  previousWording        String?                  @db.Text
  reviewedByUserId       String?
  reviewedAt             DateTime?
  secondReviewerUserId   String?
  secondReviewedAt       DateTime?
  publishedAt            DateTime?
  supersedesVersionId    String?
  householdRequirementAcknowledgements HouseholdRequirement[]

  @@unique([requirementId, versionNumber])
  @@index([requirementId, status, publishedAt])
  @@index([status, publishedAt])
}

model HouseholdRequirement {
  id                    String                      @id @default(uuid())
  tenantId              String
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requirementId         String
  requirement           Requirement                 @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  jurisdictionId        String
  jurisdiction          Jurisdiction                @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  childId               String?
  child                 Child?                      @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  status                HouseholdPreparednessStatus @default(NOT_REVIEWED)
  notes                 String?                     @db.Text
  acknowledgedVersionId String?
  acknowledgedVersion   RequirementVersion?         @relation(fields: [acknowledgedVersionId], references: [id], onDelete: Restrict)
  deadlineAt            DateTime?
  archivedAt            DateTime?
  updatedByUserId       String
  updatedBy             User                        @relation("HouseholdRequirementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  evidenceLinks         EvidenceLink[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, deadlineAt])
  @@index([tenantId, childId])
  @@index([requirementId])
}

model EvidenceLink {
  id                     String                @id @default(uuid())
  tenantId               String
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  evidenceId             String
  evidence               Evidence              @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  householdRequirementId String?
  householdRequirement   HouseholdRequirement? @relation(fields: [householdRequirementId, tenantId], references: [id, tenantId], onDelete: Restrict)
  correspondenceId       String?
  correspondence         Correspondence?       @relation("CorrespondenceEvidenceLinks", fields: [correspondenceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  purpose                EvidenceLinkPurpose
  linkedByUserId         String
  linkedBy               User                  @relation("EvidenceLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  linkedAt               DateTime              @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, evidenceId])
  @@index([householdRequirementId])
  @@index([correspondenceId])
}

model Correspondence {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  childId             String?
  child               Child?               @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  senderName          String
  issuingAuthorityId  String?
  issuingAuthority    RegulatoryAuthority? @relation(fields: [issuingAuthorityId], references: [id], onDelete: Restrict)
  subject             String
  receivedAt          DateTime
  responseDueAt       DateTime?
  respondedAt         DateTime?
  status              CorrespondenceStatus @default(RECEIVED)
  originalEvidenceId  String?
  originalEvidence    Evidence?            @relation("CorrespondenceOriginal", fields: [originalEvidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  taskId              String?
  task                Task?                @relation(fields: [taskId, tenantId], references: [id, tenantId], onDelete: Restrict)
  notes               String?              @db.Text
  createdByUserId     String
  createdBy           User                 @relation("CorrespondenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  evidenceLinks       EvidenceLink[]       @relation("CorrespondenceEvidenceLinks")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, responseDueAt])
  @@index([tenantId, childId])
}
