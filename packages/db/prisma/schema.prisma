  group   AceCommunityGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  author  User              @relation("AceCommunityPostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  replies AceCommunityReply[]
  reports AceCommunityReport[] @relation("AceCommunityReportPost")

  @@unique([id, tenantId])
  @@unique([id, tenantId, groupId])
  @@index([tenantId, groupId, createdAt])
  @@index([tenantId, authorUserId, createdAt])
}

model AceCommunityReply {
  id                  String                        @id @default(uuid())
  tenantId            String
  groupId             String
  postId              String
  authorUserId        String
  body                String                        @db.Text
  visibility          AceCommunityContentVisibility @default(VISIBLE)
  visibilityUpdatedAt DateTime?
