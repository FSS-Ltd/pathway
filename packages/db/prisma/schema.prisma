// Platform-global searchable metadata. Executable permission keys remain owned
// by the compile-time registry in @pathway/platform.
model PermissionDefinition {
  key              String                @id
  label            String
  description      String                @db.Text
  scope            PermissionScope
  sensitivity      PermissionSensitivity
  delegable        Boolean               @default(true)
  requiredModule   Module?
  requiredVertical Vertical?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  rolePermissions  OrgRolePermission[]

  @@index([isActive])
  @@index([scope, sensitivity])
}

model OrgRoleDefinition {
  id          String    @id @default(uuid())
  orgId       String
  tenantId    String?
  name        String
  description String?   @db.Text
  scope       RoleScope
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org         Org                  @relation(fields: [orgId], references: [id])
  tenant      Tenant?              @relation(fields: [tenantId, orgId], references: [id, orgId])
  permissions OrgRolePermission[]
  revisions   OrgRoleRevision[]
  assignments UserRoleAssignment[]

  @@unique([orgId, tenantId, name, isSystem])
  @@index([orgId, tenantId, isActive])
}

// Immutable snapshots make role changes reconstructable even when current
// permission membership has changed or a role has since been retired.
model OrgRoleRevision {
  id               String    @id @default(uuid())
  roleDefinitionId String
  orgId            String
  tenantId         String?
  version          Int
  name             String
  description      String?   @db.Text
  scope            RoleScope
  isActive         Boolean
  permissionKeys   Json
  actorUserId      String
  createdAt        DateTime  @default(now())

  roleDefinition OrgRoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  org            Org               @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([roleDefinitionId, version])
  @@index([orgId, roleDefinitionId, createdAt])
}

model OrgRolePermission {
  roleDefinitionId String
  permissionKey    String
  grantedById      String
  grantedAt        DateTime @default(now())

  roleDefinition OrgRoleDefinition    @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  permission     PermissionDefinition @relation(fields: [permissionKey], references: [key])

  @@id([roleDefinitionId, permissionKey])
  @@index([permissionKey])
}

model UserRoleAssignment {
  id               String    @id @default(uuid())
  orgId            String
  tenantId         String?
  userId           String
  roleDefinitionId String
  assignedById     String
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime  @default(now())

  org            Org               @relation(fields: [orgId], references: [id])
  tenant         Tenant?           @relation(fields: [tenantId, orgId], references: [id, orgId], onDelete: Restrict)
  user           User              @relation("UserRoleAssignmentAssignee", fields: [userId], references: [id])
  roleDefinition OrgRoleDefinition @relation(fields: [roleDefinitionId], references: [id])
  assignedBy     User              @relation("UserRoleAssignmentAssignedBy", fields: [assignedById], references: [id])
  revokedBy      User?             @relation("UserRoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([orgId, userId, revokedAt])
  @@index([tenantId, userId, revokedAt])
  @@index([roleDefinitionId])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
}

model AccessTagGrant {
  id          String       @id @default(uuid())
  orgId       String
  tenantId    String?
  userId      String
  tagKey      AccessTagKey
  grantedById String
  startsAt    DateTime     @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime     @default(now())

  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  tenant    Tenant? @relation(fields: [tenantId, orgId], references: [id, orgId], onDelete: Restrict)
  user      User    @relation("AccessTagGrantAssignee", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User    @relation("AccessTagGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy User?   @relation("AccessTagGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([orgId, userId, revokedAt])
  @@index([tenantId, userId, revokedAt])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
}

model OutboxEvent {
  id             String   @id @default(uuid())
  orgId          String   @default(dbgenerated("app.current_org_id()"))
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  idempotencyKey String
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  dispatchedAt   DateTime?
  failedAt       DateTime?
  claimedAt      DateTime?
  lastError      String?      @db.Text
  createdAt      DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
}

model OrgVertical {
  id        String   @id @default(uuid())
  orgId     String   @unique
  org       Org      @relation(fields: [orgId], references: [id])
  vertical  Vertical
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgModule {
  id          String       @id @default(uuid())
  orgId       String
  org         Org          @relation(fields: [orgId], references: [id])
  module      Module
  status      ModuleStatus
  activatedAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, module])
  @@index([orgId])
}

// --- Blog (platform-wide, not tenant-scoped) ---

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogAssetType {
  THUMBNAIL
  HEADER
  INLINE
}

enum BlogAssetStorage {
  POSTGRES
  SUPABASE
}

model BlogAsset {
  id            String           @id @default(uuid())
  type          BlogAssetType
  storage       BlogAssetStorage @default(POSTGRES)
  mimeType      String
  byteSize      Int
  sha256        String           @unique
  width         Int?
  height        Int?
  bytes         Bytes?
  storageBucket String?
  storageKey    String?
  createdAt     DateTime         @default(now())

  @@index([sha256])
  @@index([storageBucket, storageKey])
}

model BlogPost {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  excerpt          String?        @db.Text
  contentJson      Json
  contentHtml      String         @db.Text
  seoTitle         String?
  seoDescription   String?        @db.Text
  thumbnailImageId String?
  headerImageId    String?
  status           BlogPostStatus @default(DRAFT)
  publishedAt      DateTime?
  tags             String[]       @default([])
  authorName       String? // Set at publish from publishing user
  authorAvatarId   String? // BlogAsset id if avatar stored at publish
  readTimeMinutes  Int? // Calculated from content at publish
  isFeatured       Boolean        @default(false) // Shown in featured slot on blog index
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model AutomationApiToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  publishAudits AutomationBlogPublishAudit[]

  @@index([revokedAt, expiresAt])
  @@index([createdAt])
}

model AutomationBlogPublishAudit {
  id          String   @id @default(uuid())
  tokenId     String
  tokenName   String
  blogPostId  String
  blogSlug    String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  token AutomationApiToken @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
  @@index([blogPostId])
}

