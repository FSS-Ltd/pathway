  user   User              @relation("AceCommunityReadCursorUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, groupId, userId])
  @@index([tenantId, userId, lastReadAt])
}

model AceCommunityReport {
  id               String                   @id @default(uuid())
  tenantId         String
  groupId          String
  postId           String?
  replyId          String?
  reportedByUserId String
  reason           AceCommunityReportReason
  evidenceSnapshot String                   @db.Text
  createdAt        DateTime                 @default(now())

  tenant          Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group           AceCommunityGroup               @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  post            AceCommunityPost?               @relation("AceCommunityReportPost", fields: [postId, tenantId, groupId], references: [id, tenantId, groupId], onDelete: Restrict)
  reply           AceCommunityReply?              @relation("AceCommunityReportReply", fields: [replyId, tenantId, groupId], references: [id, tenantId, groupId], onDelete: Restrict)
  reportedBy      User                            @relation("AceCommunityReportReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  moderationActions AceCommunityModerationAction[]
  safeguardingReferences AceCommunitySafeguardingReference[] @relation("AceCommunitySafeguardingReferenceReport")

  @@unique([id, tenantId])
  @@unique([id, tenantId, groupId])
  @@index([tenantId, postId])
  @@index([tenantId, replyId])
  @@index([tenantId, groupId, createdAt])
}

model AceCommunityModerationAction {
  id               String                           @id @default(uuid())
  tenantId         String
  groupId          String
  reportId         String
  moderatorUserId  String
  actionType       AceCommunityModerationActionType
  reason           String                           @db.Text
  evidenceSnapshot String                           @db.Text
  createdAt        DateTime                         @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group     AceCommunityGroup  @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  report    AceCommunityReport @relation(fields: [reportId, tenantId, groupId], references: [id, tenantId, groupId], onDelete: Restrict)
  moderator User               @relation("AceCommunityModerationActionModerator", fields: [moderatorUserId], references: [id], onDelete: Restrict)
  safeguardingReferences AceCommunitySafeguardingReference[] @relation("AceCommunitySafeguardingReferenceModerationAction")

  @@unique([id, tenantId])
  @@index([tenantId, reportId, createdAt])
  @@index([tenantId, groupId, createdAt])
}

model AceCommunitySafeguardingReference {
  id                 String   @id @default(uuid())
  tenantId           String
  reportId           String?
  moderationActionId String?
  concernId          String
  createdAt          DateTime @default(now())

  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report           AceCommunityReport?            @relation("AceCommunitySafeguardingReferenceReport", fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  moderationAction AceCommunityModerationAction? @relation("AceCommunitySafeguardingReferenceModerationAction", fields: [moderationActionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  concern          Concern                        @relation(fields: [concernId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, reportId])
  @@index([tenantId, moderationActionId])
  @@index([concernId])
}

model MessageConversation {
  id                  String                  @id @default(uuid())
  tenantId            String
  kind                MessageConversationKind
  guardianIdentityId  String?
  createdByUserId     String
  lastMessageSequence Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianIdentity GuardianIdentity?              @relation(fields: [guardianIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy        User                           @relation("MessageConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants     MessageParticipant[]
  messages         Message[]
  readCursors      MessageParticipantReadCursor[]

  @@unique([id, tenantId])
  @@unique([tenantId, kind, guardianIdentityId])
}

model MessageParticipant {
  id                 String                 @id @default(uuid())
  tenantId           String
  conversationId     String
  userId             String
  kind               MessageParticipantKind
  guardianIdentityId String?
  joinedAt           DateTime               @default(now())
  removedAt          DateTime?

  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation     MessageConversation            @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user             User                           @relation("MessageParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  guardianIdentity GuardianIdentity?              @relation(fields: [guardianIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sentMessages     Message[]
  readCursors      MessageParticipantReadCursor[]
  deliveries       MessageDelivery[]

  @@unique([id, tenantId])
  @@unique([tenantId, conversationId, userId])
  @@index([tenantId, userId, removedAt])
  @@index([tenantId, conversationId, removedAt])
}

model Message {
  id                  String   @id @default(uuid())
  tenantId            String
  conversationId      String
  senderParticipantId String
  sequence            Int      @default(0)
  clientRequestId     String
  bodyEncrypted       String   @db.Text
  createdAt           DateTime @default(now())

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation MessageConversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sender       MessageParticipant  @relation(fields: [senderParticipantId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries   MessageDelivery[]
  attachments  MessageAttachment[]

  @@unique([id, tenantId])
  @@unique([tenantId, conversationId, sequence])
  @@unique([tenantId, conversationId, senderParticipantId, clientRequestId])
  @@index([tenantId, conversationId, createdAt])
}

model MessageParticipantReadCursor {
  id               String   @id @default(uuid())
  tenantId         String
  conversationId   String
  participantId    String
  lastReadSequence Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation MessageConversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  participant  MessageParticipant  @relation(fields: [participantId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, conversationId, participantId])
  @@index([tenantId, participantId])
}

model MessageDelivery {
  id                     String                @id @default(uuid())
  tenantId               String
  messageId              String
  recipientParticipantId String
  status                 MessageDeliveryStatus @default(PENDING)
  deliveredAt            DateTime?
  readAt                 DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message              Message            @relation(fields: [messageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recipientParticipant MessageParticipant @relation(fields: [recipientParticipantId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, messageId, recipientParticipantId])
  @@index([tenantId, recipientParticipantId, status, createdAt])
}

model MessageAttachment {
  id          String   @id @default(uuid())
  tenantId    String
  messageId   String
  storageKey  String
  contentType String
  byteSize    Int
  sha256      String
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message Message @relation(fields: [messageId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, messageId])
}

model AceNotice {
  id              String            @id @default(uuid())
  tenantId        String
  createdByUserId String
  title           String
  body            String            @db.Text
  audience        AceNoticeAudience
  publishedAt     DateTime?
  expiresAt       DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy       User                      @relation("AceNoticeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  audienceMembers AceNoticeAudienceMember[]
  attachments     AceNoticeAttachment[]

  @@unique([id, tenantId])
  @@index([tenantId, publishedAt])
  @@index([tenantId, withdrawnAt, publishedAt(sort: Desc)])
}

model AceNoticeAudienceMember {
  id                 String                      @id @default(uuid())
  tenantId           String
  noticeId           String
  recipientUserId    String
  recipientKind      AceNoticeAudienceMemberKind
  guardianIdentityId String?
  createdAt          DateTime                    @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notice           AceNotice         @relation(fields: [noticeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recipient        User              @relation("AceNoticeAudienceRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  guardianIdentity GuardianIdentity? @relation(fields: [guardianIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receipt          AceNoticeReceipt?

  @@unique([id, tenantId])
  @@unique([tenantId, noticeId, recipientUserId])
  @@index([tenantId, recipientUserId, createdAt])
}

model AceNoticeReceipt {
  id               String    @id @default(uuid())
  tenantId         String
  audienceMemberId String
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  audienceMember AceNoticeAudienceMember @relation(fields: [audienceMemberId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([audienceMemberId, tenantId])
  @@index([tenantId, deliveredAt, readAt])
}

model AceNoticeAttachment {
  id          String   @id @default(uuid())
  tenantId    String
  noticeId    String
  storageKey  String
  contentType String
  byteSize    Int
  sha256      String
  createdAt   DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notice AceNotice @relation(fields: [noticeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, noticeId])
}

model HandoverLog {
  id                 String               @id @default(uuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  groupId            String
  group              Group                @relation(fields: [groupId], references: [id])
  handoverDate       DateTime             @db.Date
  status             HandoverLogStatus    @default(DRAFT)
  currentContentJson Json
  createdByUserId    String
  createdByUser      User                 @relation("HandoverLogCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId   String?
  approvedByUser     User?                @relation("HandoverLogApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt         DateTime?
  versions           HandoverLogVersion[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([tenantId, groupId, handoverDate])
  @@index([tenantId, handoverDate])
  @@index([tenantId, groupId])
  @@index([status])
}

model HandoverLogVersion {
  id                  String      @id @default(uuid())
  handoverLogId       String
  handoverLog         HandoverLog @relation(fields: [handoverLogId], references: [id], onDelete: Cascade)
  versionNumber       Int
  contentSnapshotJson Json
  editedByUserId      String
  editedByUser        User        @relation("HandoverLogVersionEditedBy", fields: [editedByUserId], references: [id])
  editedAt            DateTime    @default(now())
  changeSummary       String?
  diffJson            Json?

  @@index([handoverLogId, versionNumber])
}

// A planned trip is site-scoped. Checkpoint attendance is deliberately separate
// from session attendance because staff may add or reorder checkpoints during
// the day without changing the trip's core itinerary.
model Trip {
  id                 String    @id @default(uuid())
  tenantId           String
  title              String
  destination        String
  startsAt           DateTime
  endsAt             DateTime
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?   @db.Text
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("TripCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy    User?            @relation("TripCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  checkpoints    TripCheckpoint[]
  permissionSlip PermissionSlip?

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
}

// A staff-configurable, ordered moment at which children are accounted for.
// It intentionally has no staff attendance relation.
model TripCheckpoint {
  id              String    @id @default(uuid())
  tenantId        String
  tripId          String
  label           String    @db.Text
  position        Int
  plannedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  trip       Trip                       @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy  User                       @relation("TripCheckpointCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  attendance TripCheckpointAttendance[]

  @@unique([id, tenantId])
  @@unique([tenantId, tripId, position])
  @@index([tenantId, tripId])
}

model TripCheckpointAttendance {
  id               String   @id @default(uuid())
  tenantId         String
  tripCheckpointId String
  childId          String
  present          Boolean
  markedByUserId   String
  markedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tripCheckpoint TripCheckpoint @relation(fields: [tripCheckpointId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child          Child          @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  markedBy       User           @relation("TripCheckpointAttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, tripCheckpointId, childId])
  @@index([tenantId, childId])
}

// A trip has at most one permission-slip workflow. Published wording lives in
// PermissionSlipVersion so changing consent wording cannot rewrite history.
model PermissionSlip {
  id              String   @id @default(uuid())
  tenantId        String
  tripId          String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  trip      Trip                    @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User                    @relation("PermissionSlipCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions  PermissionSlipVersion[]

  @@unique([id, tenantId])
  @@unique([tripId, tenantId])
}

model PermissionSlipVersion {
  id                   String                             @id @default(uuid())
  tenantId             String
  permissionSlipId     String
  version              Int
  contentSnapshot      Json
  versionHash          String?
  changeClassification PermissionSlipChangeClassification @default(INITIAL)
  requiresReconsent    Boolean                            @default(false)
  publishedAt          DateTime?
  publishedByUserId    String?
  supersedesVersionId  String?
  createdByUserId      String
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissionSlip    PermissionSlip            @relation(fields: [permissionSlipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy         User                      @relation("PermissionSlipVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("PermissionSlipVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  supersedesVersion PermissionSlipVersion?    @relation("PermissionSlipVersionSupersession", fields: [supersedesVersionId, tenantId, permissionSlipId], references: [id, tenantId, permissionSlipId], onDelete: Restrict)
  supersededBy      PermissionSlipVersion[]   @relation("PermissionSlipVersionSupersession")
  recipients        PermissionSlipRecipient[]
  responses         PermissionSlipResponse[]
  exceptions        PermissionSlipException[]
  reminders         PermissionSlipReminder[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, permissionSlipId])
  @@unique([id, tenantId, versionHash])
  @@unique([tenantId, permissionSlipId, version])
  @@index([tenantId, permissionSlipId, publishedAt])
}

// A recipient is a child snapshot for a particular version. It makes later
// changes to a trip's participant list unable to change who was asked.
model PermissionSlipRecipient {
  id                      String   @id @default(uuid())
  tenantId                String
  permissionSlipVersionId String
  childId                 String
  createdAt               DateTime @default(now())

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissionSlipVersion PermissionSlipVersion     @relation(fields: [permissionSlipVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child                 Child                     @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  responses             PermissionSlipResponse[]
  exceptions            PermissionSlipException[]
  reminders             PermissionSlipReminder[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, permissionSlipVersionId])
  @@unique([tenantId, permissionSlipVersionId, childId])
  @@index([tenantId, childId])
}

// responsePayload is encrypted at rest; it can contain guardian-provided
// special arrangements or supporting details.
model PermissionSlipResponse {
  id                          String                         @id @default(uuid())
  tenantId                    String
  permissionSlipVersionId     String
  permissionSlipRecipientId   String
  childId                     String
  guardianChildRelationshipId String
  guardianIdentityId          String
  versionHash                 String
  decision                    PermissionSlipResponseDecision
  responsePayload             String                         @db.Text
  idempotencyKey              String
  respondedAt                 DateTime                       @default(now())
  createdAt                   DateTime                       @default(now())

  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissionSlipVersion     PermissionSlipVersion     @relation(fields: [permissionSlipVersionId, tenantId, versionHash], references: [id, tenantId, versionHash], onDelete: Restrict)
  permissionSlipRecipient   PermissionSlipRecipient   @relation(fields: [permissionSlipRecipientId, tenantId, childId, permissionSlipVersionId], references: [id, tenantId, childId, permissionSlipVersionId], onDelete: Restrict)
  child                     Child                     @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  guardianChildRelationship GuardianChildRelationship @relation(fields: [guardianChildRelationshipId, tenantId, childId, guardianIdentityId], references: [id, tenantId, childId, guardianIdentityId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, permissionSlipVersionId, guardianChildRelationshipId, idempotencyKey])
  @@index([tenantId, permissionSlipRecipientId])
}

// reason is encrypted at rest. These rows preserve an accountable record when
// a signed physical form or telephone confirmation is accepted instead of an
// in-portal guardian response.
model PermissionSlipException {
  id                        String                         @id @default(uuid())
  tenantId                  String
  permissionSlipVersionId   String
  permissionSlipRecipientId String
  childId                   String
  versionHash               String
  source                    PermissionSlipExceptionSource
  decision                  PermissionSlipResponseDecision
  recordedByUserId          String
  witnessUserId             String
  reason                    String                         @db.Text
  recordedAt                DateTime                       @default(now())
  createdAt                 DateTime                       @default(now())

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissionSlipVersion   PermissionSlipVersion   @relation(fields: [permissionSlipVersionId, tenantId, versionHash], references: [id, tenantId, versionHash], onDelete: Restrict)
  permissionSlipRecipient PermissionSlipRecipient @relation(fields: [permissionSlipRecipientId, tenantId, childId, permissionSlipVersionId], references: [id, tenantId, childId, permissionSlipVersionId], onDelete: Restrict)
  child                   Child                   @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy              User                    @relation("PermissionSlipExceptionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  witness                 User                    @relation("PermissionSlipExceptionWitness", fields: [witnessUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, permissionSlipRecipientId])
}

model PermissionSlipReminder {
  id                        String    @id @default(uuid())
  tenantId                  String
  permissionSlipVersionId   String
  permissionSlipRecipientId String
  childId                   String
  scheduledFor              DateTime
  sentAt                    DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime  @default(now())

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissionSlipVersion   PermissionSlipVersion   @relation(fields: [permissionSlipVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  permissionSlipRecipient PermissionSlipRecipient @relation(fields: [permissionSlipRecipientId, tenantId, childId, permissionSlipVersionId], references: [id, tenantId, childId, permissionSlipVersionId], onDelete: Restrict)
