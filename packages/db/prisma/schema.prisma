generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  PARENT
  LEAD
  SUPPORT
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum SwapStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum AnnouncementAudience {
  ALL
  PARENTS
  STAFF
}

// NEW: Org-level roles (optional, for suites/billing admins)
enum OrgRole {
  ORG_ADMIN
  ORG_BILLING
  ORG_MEMBER
}

// NEW: Site-level membership roles (Site == Tenant boundary for RLS)
enum SiteRole {
  SITE_ADMIN
  STAFF
  VIEWER
}

// NEW: Billing provider and subscription status
enum BillingProvider {
  STRIPE
  GOCARDLESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PendingOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  VIEWED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_RETIRED
  ASSIGNMENT_CREATED
  ASSIGNMENT_REVOKED
}

enum AuditEntityType {
  CONCERN
  CHILD_NOTE
  ORG_ROLE
  ROLE_ASSIGNMENT
}

enum LeadKind {
  DEMO
  TOOLKIT
  TRIAL
  READINESS
}

enum ChildGuardianContactType {
  PRIMARY_GUARDIAN
  EMERGENCY_CONTACT
}

// Selected once at initial plan purchase; drives which features are visible to the org.
// Keep in sync with SectorId in apps/web/content/sectors.ts and Sector in packages/types.
enum OrgSector {
  CHURCH
  CLUB
  SCHOOL
  CHARITY
}

// NexSteps 2.0 platform engine (docs/NexStepsV2/01-platform-engine-data-model-and-resolvers.md).
// Superset of OrgSector — SCHOOL splits into three verticals. Not yet consumed by any
// application code; PR 1.2 adds the OrgVertical/OrgModule models that reference these.
enum Vertical {
  CHURCH
  INDEPENDENT_SCHOOL
  ACE_SCHOOL
  STATE_SCHOOL
  NURSERY
  CHARITY
  CLUB
}

enum Module {
  FINANCE
  EVENTS
  TRANSPORT
  MEALS
  ASSET_MANAGEMENT
  HR
  AI_WORKSPACE
  ADVANCED_REPORTING
  LEARNING
}

enum ModuleStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReportBundleStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AcademicYearStatus {
  ACTIVE
  ARCHIVED
}

enum AcademicPeriodStatus {
  ACTIVE
  ARCHIVED
}

enum StudentSubjectEnrollmentStatus {
  ACTIVE
  ENDED
}

enum PaceAssessmentType {
  SELF_TEST
  PACE_TEST
}

enum PaceAssessmentResult {
  PASSED
  FAILED
}

enum PaceTrackStatus {
  AHEAD
  ON_TRACK
  AT_RISK
  BEHIND
  BLOCKED
}

enum BehaviourType {
  MERIT
  DEMERIT
  GENERAL
}

enum BehaviourVisibility {
  GENERAL
  SENSITIVE
}

enum GuardianLegalAccess {
  FULL
  LIMITED
  NONE
}

enum FamilyIdentityTarget {
  GUARDIAN
  STUDENT
}

enum AceReportDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

enum AceReportReviewDecision {
  APPROVED
  REJECTED
}

enum PermissionScope {
  organisation
  site
  relationship
  assignment
}

enum PermissionSensitivity {
  standard
  sensitive
  protected
}

enum RoleScope {
  organisation
  site
  relationship
}

// Platform-global searchable metadata. Executable permission keys remain owned
// by the compile-time registry in @pathway/platform.
model PermissionDefinition {
  key              String                @id
  label            String
  description      String                @db.Text
  scope            PermissionScope
  sensitivity      PermissionSensitivity
  delegable        Boolean               @default(true)
  requiredModule   Module?
  requiredVertical Vertical?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  rolePermissions  OrgRolePermission[]

  @@index([isActive])
  @@index([scope, sensitivity])
}

model OrgRoleDefinition {
  id          String    @id @default(uuid())
  orgId       String
  tenantId    String?
  name        String
  description String?   @db.Text
  scope       RoleScope
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org         Org      @relation(fields: [orgId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId, orgId], references: [id, orgId])
  permissions OrgRolePermission[]
  revisions   OrgRoleRevision[]
  assignments UserRoleAssignment[]

  @@unique([orgId, tenantId, name, isSystem])
  @@index([orgId, tenantId, isActive])
}

// Immutable snapshots make role changes reconstructable even when current
// permission membership has changed or a role has since been retired.
model OrgRoleRevision {
  id               String    @id @default(uuid())
  roleDefinitionId String
  orgId            String
  tenantId         String?
  version          Int
  name             String
  description      String?   @db.Text
  scope            RoleScope
  isActive         Boolean
  permissionKeys   Json
  actorUserId      String
  createdAt        DateTime  @default(now())

  roleDefinition OrgRoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  org            Org               @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([roleDefinitionId, version])
  @@index([orgId, roleDefinitionId, createdAt])
}

model OrgRolePermission {
  roleDefinitionId String
  permissionKey     String
  grantedById       String
  grantedAt         DateTime          @default(now())

  roleDefinition OrgRoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  permission     PermissionDefinition @relation(fields: [permissionKey], references: [key])

  @@id([roleDefinitionId, permissionKey])
  @@index([permissionKey])
}

model UserRoleAssignment {
  id               String    @id @default(uuid())
  orgId            String
  tenantId         String?
  userId           String
  roleDefinitionId String
  assignedById     String
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime  @default(now())

  org            Org               @relation(fields: [orgId], references: [id])
  tenant         Tenant?           @relation(fields: [tenantId, orgId], references: [id, orgId], onDelete: Restrict)
  user           User              @relation("UserRoleAssignmentAssignee", fields: [userId], references: [id])
  roleDefinition OrgRoleDefinition @relation(fields: [roleDefinitionId], references: [id])
  assignedBy     User              @relation("UserRoleAssignmentAssignedBy", fields: [assignedById], references: [id])
  revokedBy      User?             @relation("UserRoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([orgId, userId, revokedAt])
  @@index([tenantId, userId, revokedAt])
  @@index([roleDefinitionId])
  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
}

model OutboxEvent {
  id             String   @id @default(uuid())
  orgId          String   @default(dbgenerated("app.current_org_id()"))
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  idempotencyKey String
  createdAt      DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@unique([orgId, idempotencyKey])
}

model OrgVertical {
  id        String   @id @default(uuid())
  orgId     String   @unique
  org       Org      @relation(fields: [orgId], references: [id])
  vertical  Vertical
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgModule {
  id          String       @id @default(uuid())
  orgId       String
  org         Org          @relation(fields: [orgId], references: [id])
  module      Module
  status      ModuleStatus
  activatedAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, module])
  @@index([orgId])
}

// --- Blog (platform-wide, not tenant-scoped) ---

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogAssetType {
  THUMBNAIL
  HEADER
  INLINE
}

enum BlogAssetStorage {
  POSTGRES
  SUPABASE
}

model BlogAsset {
  id        String           @id @default(uuid())
  type      BlogAssetType
  storage   BlogAssetStorage  @default(POSTGRES)
  mimeType  String
  byteSize  Int
  sha256    String           @unique
  width     Int?
  height    Int?
  bytes     Bytes?
  storageBucket String?
  storageKey    String?
  createdAt DateTime         @default(now())

  @@index([sha256])
  @@index([storageBucket, storageKey])
}

model BlogPost {
  id                 String         @id @default(uuid())
  title              String
  slug               String         @unique
  excerpt            String?        @db.Text
  contentJson        Json
  contentHtml        String         @db.Text
  seoTitle           String?
  seoDescription     String?        @db.Text
  thumbnailImageId   String?
  headerImageId      String?
  status             BlogPostStatus @default(DRAFT)
  publishedAt        DateTime?
  tags               String[]       @default([])
  authorName         String?        // Set at publish from publishing user
  authorAvatarId     String?        // BlogAsset id if avatar stored at publish
  readTimeMinutes    Int?           // Calculated from content at publish
  isFeatured         Boolean        @default(false) // Shown in featured slot on blog index
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model AutomationApiToken {
  id        String   @id @default(uuid())
  name      String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  lastUsedAt DateTime?

  publishAudits AutomationBlogPublishAudit[]

  @@index([revokedAt, expiresAt])
  @@index([createdAt])
}

model AutomationBlogPublishAudit {
  id          String   @id @default(uuid())
  tokenId     String
  tokenName   String
  blogPostId  String
  blogSlug    String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  token AutomationApiToken @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
  @@index([blogPostId])
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  UNKNOWN
}

enum HandoverLogStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

// --- Models ---

// NEW: Org (Suite) — business/billing owner; may contain multiple Tenants (sites)
model Org {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  planCode         String // e.g., trial|starter|standard|pro|suite_*
  isSuite          Boolean                  @default(false)
  isMasterOrg      Boolean                  @default(false) // Internal/platform org: no Stripe, unlimited, non-billable
  parentPortalEnabled Boolean                  @default(true)
  // Selected once at initial plan purchase. Nullable so orgs created before this field
  // existed remain valid; new orgs should always set it at purchase time.
  sector           OrgSector?
  // Org-level white-label logo, stored in the public Supabase bucket. Nullable — falls
  // back to the NexSteps mark. See docs/design/per-org-logo.md.
  logoStorageKey   String?
  logoContentType  String?
  stripeCustomerId String?                  @unique
  tenants          Tenant[]
  subscriptions    Subscription[]
  entitlements     OrgEntitlementSnapshot[]
  retentionPolicy  OrgRetentionPolicy?
  usageCounters    UsageCounters[]
  billingEvents    BillingEvent[]
  userOrgRoles     UserOrgRole[]
  orgMemberships   OrgMembership[]
  auditEvents       AuditEvent[]
  staffActivities   StaffActivity[]
  pendingOrders     PendingOrder[]
  invites           Invite[]
  publicSignupLinks PublicSignupLink[]
  deletedUsers      OrgDeletedUser[]
  orgVertical       OrgVertical?
  orgModules        OrgModule[]
  roleDefinitions   OrgRoleDefinition[]
  roleRevisions     OrgRoleRevision[]
  roleAssignments   UserRoleAssignment[]
  outboxEvents      OutboxEvent[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

// NOTE: Tenant == Site (true isolation boundary / RLS). Admin UI “Site selector”
// maps directly to this model. Future migrations may introduce a dedicated `Site`
// wrapper but the tenant id remains the canonical RLS key.
model Tenant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  timezone String? // IANA timezone e.g. Europe/London

  // NEW: link tenant (site) to its owning Org
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  users           User[]
  groups          Group[]
  children        Child[]
  roles           UserTenantRole[]
  sessions        Session[]
  lessons         Lesson[]
  announcements   Announcement[]
  preferences     VolunteerPreference[]
  auditEvents     AuditEvent[]
  staffActivities StaffActivity[]
  pendingOrders   PendingOrder[]
  siteMemberships        SiteMembership[]
  lastActiveUsers        User[]                  @relation("UserLastActiveTenant")
  staffUnavailableDates  StaffUnavailableDate[]
  staffPreferredGroups   StaffPreferredGroup[]
  sessionStaffAttendance SessionStaffAttendance[]
  publicSignupLinks      PublicSignupLink[]
  emergencyContacts      EmergencyContact[]
  parentSignupConsents   ParentSignupConsent[]
  childGuardianContacts  ChildGuardianContact[]
  handoverLogs           HandoverLog[]
  subjects               Subject[]
  learningLogs           LearningLog[]
  evidence               Evidence[]
  reportBundles          ReportBundle[]
  academicYears          AcademicYear[]
  academicPeriods        AcademicPeriod[]
  subjectEnrollments     StudentSubjectEnrollment[]
  paceAssessments        PaceAssessment[]
  paceProgress           PaceProgress[]
  pacePolicies           PacePolicy[]
  pacePolicyOverrides    PacePolicyOverride[]
  behaviourEntries       BehaviourEntry[]
  demeritPolicies        DemeritPolicy[]
  demeritStageOverrides  DemeritStageOverride[]
  studentPortalPolicy    StudentPortalPolicy?
  guardianIdentities     GuardianIdentity[]
  studentIdentities      StudentIdentity[]
  studentIdentityLinks   StudentIdentityLink[]
  guardianChildRelationships GuardianChildRelationship[]
  familyIdentityInvites  FamilyIdentityInvite[]
  aceTermReports         AceTermReport[]
  aceReportCompilations  AceReportCompilation[]
  aceReportDrafts        AceReportDraft[]
  aceReportReviews       AceReportReview[]
  aceTermReportVersions  AceTermReportVersion[]
  roleDefinitions        OrgRoleDefinition[]
  roleAssignments        UserRoleAssignment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([orgId])
  @@unique([id, orgId])
}

model UserTenantRole {
  id       String @id @default(uuid())
  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role])
}

// NEW: User ↔ Org roles (optional, for suite-level administration)
model UserOrgRole {
  id     String  @id @default(uuid())
  userId String
  orgId  String
  role   OrgRole

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId, role])
  @@index([orgId])
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  name        String?
  displayName String?
  firstName   String?
  lastName    String?
  dateOfBirth        DateTime? @db.Date
  avatarUrl          String?   // External URL fallback (e.g. Auth0)
  avatarKey          String?   // Supabase Storage key for uploaded avatar
  avatarBytes        Bytes?    // Inline fallback until storage backfill
  avatarContentType  String?   // e.g. image/jpeg
  isActive           Boolean   @default(true)
  superUser          Boolean   @default(false) // Nexsteps staff only (e.g. blog admin)

  // NOTE: kept for backward compatibility (single-tenant user). For suites, prefer UserTenantRole.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Preferred site (tenant) remembered by the API when multiple memberships exist.
  lastActiveTenantId String?
  lastActiveTenant   Tenant? @relation("UserLastActiveTenant", fields: [lastActiveTenantId], references: [id])

  children         Child[]               @relation("ParentChildren")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  firstLoginAt     DateTime?                // Track when user first logs in (for onboarding)
  hasServeAccess   Boolean               @default(false)
  hasFamilyAccess  Boolean               @default(false)
  roles            UserTenantRole[]
  siteMemberships  SiteMembership[]
  orgMemberships   OrgMembership[]
  assignments      Assignment[]
  preferences      VolunteerPreference[]
  notes            ChildNote[]           @relation("ChildNoteAuthor")
  approvedNotes    ChildNote[]           @relation("ChildNoteApprovedBy")
  auditEvents      AuditEvent[]          @relation("AuditActor")
  swapRequestsFrom SwapRequest[]         @relation("SwapFromUser")
  swapRequestsTo   SwapRequest[]         @relation("SwapToUser")
  orgRoles         UserOrgRole[]
  staffActivities      StaffActivity[]
  identities           UserIdentity[]
  guardianIdentities   GuardianIdentity[]
  studentIdentities    StudentIdentity[]
  revokedStudentIdentityLinks StudentIdentityLink[] @relation("StudentIdentityLinkRevokedBy")
  revokedGuardianChildRelationships GuardianChildRelationship[] @relation("GuardianChildRelationshipRevokedBy")
  familyIdentityInvites FamilyIdentityInvite[] @relation("FamilyIdentityInviteUser")
  familyIdentityInvitesCreated FamilyIdentityInvite[] @relation("FamilyIdentityInviteCreatedBy")
  familyIdentityInvitesRevoked FamilyIdentityInvite[] @relation("FamilyIdentityInviteRevokedBy")
  invitesCreated          Invite[]                  @relation("InviteCreatedBy")
  publicSignupLinksCreated PublicSignupLink[]       @relation("PublicSignupLinkCreatedBy")
  orgDeletionRecords    OrgDeletedUser[]          @relation("OrgDeletedUserTarget")
  deletedOrgUsers       OrgDeletedUser[]          @relation("OrgDeletedUserActor")
  staffUnavailableDates   StaffUnavailableDate[]
  staffPreferredGroups    StaffPreferredGroup[]
  emergencyContacts       EmergencyContact[]
  parentSignupConsents    ParentSignupConsent[]
  staffAttendanceAsStaff  SessionStaffAttendance[] @relation("StaffAttendanceForUser")
  staffAttendanceMarkedBy SessionStaffAttendance[] @relation("StaffAttendanceMarkedBy")
  handoverLogsCreated     HandoverLog[]           @relation("HandoverLogCreatedBy")
  handoverLogsApproved    HandoverLog[]           @relation("HandoverLogApprovedBy")
  handoverLogVersions     HandoverLogVersion[]    @relation("HandoverLogVersionEditedBy")
  loggedLearningLogs      LearningLog[]           @relation("LearningLogLoggedBy")
  uploadedEvidence        Evidence[]              @relation("EvidenceUploadedBy")
  requestedReportBundles  ReportBundle[]          @relation("ReportBundleRequestedBy")
  recordedSubjectEnrollments StudentSubjectEnrollment[] @relation("StudentSubjectEnrollmentRecordedBy")
  recordedPaceAssessments    PaceAssessment[]            @relation("PaceAssessmentRecordedBy")
  createdPacePolicies        PacePolicy[]                @relation("PacePolicyCreatedBy")
  authorisedPaceOverrides    PacePolicyOverride[]        @relation("PacePolicyOverrideAuthorisedBy")
  recordedBehaviourEntries  BehaviourEntry[]            @relation("BehaviourEntryRecordedBy")
  createdDemeritPolicies     DemeritPolicy[]             @relation("DemeritPolicyCreatedBy")
  authorisedDemeritOverrides DemeritStageOverride[]      @relation("DemeritStageOverrideAuthorisedBy")
  compiledAceReports          AceReportCompilation[]      @relation("AceReportCompilationCompiledBy")
  authoredAceReportDrafts     AceReportDraft[]            @relation("AceReportDraftAuthor")
  reviewedAceReports          AceReportReview[]           @relation("AceReportReviewReviewer")
  roleAssignments         UserRoleAssignment[]    @relation("UserRoleAssignmentAssignee")
  roleAssignmentsGranted  UserRoleAssignment[]    @relation("UserRoleAssignmentAssignedBy")
  roleAssignmentsRevoked  UserRoleAssignment[]    @relation("UserRoleAssignmentRevokedBy")
}

// Auth identity linking external providers (e.g., Auth0) to internal users.
model UserIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  email           String?
  displayName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject])
  @@index([userId])
}

// A global user may be a guardian in more than one tenant. The identity does
// not itself grant data access; GuardianChildRelationship is the access fact.
model GuardianIdentity {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  relationships GuardianChildRelationship[]
  acceptedInvites FamilyIdentityInvite[]    @relation("FamilyIdentityInviteAcceptedGuardian")

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@unique([id, tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// A global user may represent a student only inside a tenant. Student access
// additionally requires an active StudentIdentityLink and enabled tenant policy.
model StudentIdentity {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  links           StudentIdentityLink[]
  acceptedInvites FamilyIdentityInvite[] @relation("FamilyIdentityInviteAcceptedStudent")

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@unique([id, tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// One tenant-owned portal setting controls whether new active student links can
// be created. It is intentionally one row per tenant rather than an id record.
model StudentPortalPolicy {
  tenantId             String   @id
  studentPortalEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StudentIdentityLink {
  id                String   @id @default(uuid())
  tenantId          String
  studentIdentityId String
  childId           String
  linkedAt          DateTime @default(now())
  endedAt           DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  revocationReason  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentIdentity StudentIdentity @relation(fields: [studentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child           Child           @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revokedBy       User?           @relation("StudentIdentityLinkRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, childId])
  @@index([tenantId, studentIdentityId])
}

model GuardianChildRelationship {
  id                 String              @id @default(uuid())
  tenantId           String
  guardianIdentityId String
  childId            String
  legalAccess        GuardianLegalAccess @default(FULL)
  startsAt           DateTime            @default(now())
  endedAt            DateTime?
  revokedAt          DateTime?
  revokedByUserId    String?
  revocationReason   String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianIdentity GuardianIdentity @relation(fields: [guardianIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child            Child            @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revokedBy        User?            @relation("GuardianChildRelationshipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, childId])
  @@index([tenantId, guardianIdentityId])
}

// Invitation lifecycle only. A later command service delivers the invite and
// creates the separate guardian relationship or student link after acceptance.
model FamilyIdentityInvite {
  id                         String               @id @default(uuid())
  tenantId                   String
  invitedUserId              String
  target                     FamilyIdentityTarget
  childId                    String?
  createdByUserId            String
  expiresAt                  DateTime
  acceptedAt                 DateTime?
  acceptedGuardianIdentityId String?
  acceptedStudentIdentityId  String?
  revokedAt                  DateTime?
  revokedByUserId            String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedUser              User              @relation("FamilyIdentityInviteUser", fields: [invitedUserId], references: [id], onDelete: Restrict)
  child                    Child?            @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy                User              @relation("FamilyIdentityInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy                User?             @relation("FamilyIdentityInviteRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  acceptedGuardianIdentity GuardianIdentity? @relation("FamilyIdentityInviteAcceptedGuardian", fields: [acceptedGuardianIdentityId, tenantId, invitedUserId], references: [id, tenantId, userId], onDelete: Restrict)
  acceptedStudentIdentity  StudentIdentity?  @relation("FamilyIdentityInviteAcceptedStudent", fields: [acceptedStudentIdentityId, tenantId, invitedUserId], references: [id, tenantId, userId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, invitedUserId, createdAt])
  @@index([tenantId, childId])
  @@index([expiresAt])
}

// Membership of a user to an Org (suite-level). Useful for listing sites the user can manage.
model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole  @default(ORG_MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

// Membership of a user to a Site (Tenant). This is the primary tenant access control.
model SiteMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      SiteRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

// Invite model for onboarding new users to Orgs and Sites
model Invite {
  id              String @id @default(uuid())
  orgId           String
  org             Org    @relation(fields: [orgId], references: [id])
  createdByUserId String
  createdBy       User   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  email           String // normalized to lowercase
  name            String? // Optional name for the invitee

  // Org-level role (optional, if granting org access)
  orgRole OrgRole?

  // Site-level access (optional, if granting site access)
  siteIdsJson String? // JSON array of site IDs ["site1", "site2"]
  siteRole    SiteRole?

  // Token and expiry
  tokenHash String   @unique // Store hash only, never raw token
  expiresAt DateTime

  // Lifecycle timestamps
  usedAt     DateTime?
  revokedAt  DateTime?
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, email])
  @@index([tokenHash])
  @@index([email])
}

model OrgDeletedUser {
  id              String   @id @default(uuid())
  orgId           String
  userId          String
  deletedByUserId String
  name            String
  displayName     String?
  email           String?
  priorOrgRole    OrgRole?
  priorSiteCount  Int      @default(0)
  deletedAt       DateTime @default(now())

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User @relation("OrgDeletedUserTarget", fields: [userId], references: [id])
  deletedBy User @relation("OrgDeletedUserActor", fields: [deletedByUserId], references: [id])

  @@index([orgId, deletedAt])
  @@index([userId])
  @@index([deletedByUserId])
}

// Invite-only public parent signup link (site-specific; token in QR link).
// tokenForDisplay: stored only for admin re-display of the same QR; never logged; verification uses tokenHash only.
model PublicSignupLink {
  id              String    @id @default(uuid())
  orgId           String
  tenantId        String
  tokenHash       String
  tokenForDisplay String?   // For returning same signup URL to admin; never log or expose outside admin response
  createdByUserId String?
  createdBy       User?     @relation("PublicSignupLinkCreatedBy", fields: [createdByUserId], references: [id])
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org    Org    @relation(fields: [orgId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, revokedAt, expiresAt])
  @@index([orgId])
}

// Emergency contact for a parent (guardian) in a tenant.
// name/phone/relationship are encrypted at rest — see packages/db/src/pii-encryption.ts.
model EmergencyContact {
  id          String   @id @default(uuid())
  userId      String
  tenantId    String
  name        String
  phone       String
  relationship String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// Consent record for parent signup (timestamps + consenting adult identity).
// consentingAdultName/consentingAdultRelationship are encrypted at rest — see packages/db/src/pii-encryption.ts.
model ParentSignupConsent {
  id                        String    @id @default(uuid())
  userId                    String
  tenantId                  String
  dataProcessingConsentAt   DateTime
  firstAidConsentAt        DateTime?
  consentingAdultName       String
  consentingAdultRelationship String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// fullName/phone/relationshipToChild are encrypted at rest — see packages/db/src/pii-encryption.ts.
model ChildGuardianContact {
  id                         String                   @id @default(uuid())
  childId                    String
  tenantId                   String
  fullName                   String
  email                      String?
  phone                      String?
  relationshipToChild        String?
  contactType                ChildGuardianContactType @default(PRIMARY_GUARDIAN)
  dataProcessingConsentAt    DateTime?
  firstAidConsentAt          DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([tenantId])
  @@index([tenantId, contactType])
}

// allergies/additionalNeedsNotes/gpName/gpPhone/specialNeedsOther/notes are encrypted
// at rest — see packages/db/src/pii-encryption.ts. dateOfBirth is NOT yet encrypted
// (would require a DateTime -> String column change; tracked as a follow-up).
model Child {
  id                  String       @id @default(uuid())
  firstName           String
  lastName            String
  preferredName       String?
  dateOfBirth         DateTime?
  allergies           String       @default("unknown")
  additionalNeedsNotes String?
  // Safeguarding-relevant info from public signup
  schoolName          String?
  yearGroup           String?
  gpName              String?
  gpPhone             String?
  specialNeedsType    String?      // e.g. none, sen_support, ehcp, other
  specialNeedsOther   String?     // Free text when specialNeedsType is "other"
  photoConsent        Boolean      @default(false)
  photoKey            String?
  photoBytes          Bytes?       // Inline fallback until storage backfill
  photoContentType    String?      // e.g. image/jpeg
  notes               String?
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  guardians           User[]       @relation("ParentChildren")
  guardianContacts    ChildGuardianContact[]
  groupId             String?
  group               Group?       @relation(fields: [groupId], references: [id])
  disabilities        String[]     @default([])
  concerns            Concern[]
  attendance          Attendance[]
  childNotes          ChildNote[]
  learningLogs        LearningLog[]
  subjectEnrollments  StudentSubjectEnrollment[]
  paceAssessments     PaceAssessment[]
  paceProgress        PaceProgress[]
  pacePolicyOverrides PacePolicyOverride[]
  behaviourEntries    BehaviourEntry[]
  demeritStageOverrides DemeritStageOverride[]
  studentIdentityLinks StudentIdentityLink[]
  guardianChildRelationships GuardianChildRelationship[]
  familyIdentityInvites FamilyIdentityInvite[]
  aceTermReports        AceTermReport[]
  evidence            Evidence[]
  reportBundles       ReportBundle[]
  // Guest pass (day visitor): auto-deleted by the workers guest-pass-cleanup sweep
  // ~1h after guestExpiresAt. See docs/design/guest-pass-24h.md.
  isGuest             Boolean      @default(false)
  guestExpiresAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([tenantId])
  @@index([isGuest, guestExpiresAt])
  @@unique([id, tenantId])
}

model Group {
  id          String       @id @default(uuid())
  name        String
  minAge      Int?
  maxAge      Int?
  description String?
  color       String?      // Hex color for rota/schedule cards (e.g. #0ec2a2)
  isActive    Boolean      @default(true)
  sortOrder   Int?
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  children              Child[]
  attendances           Attendance[]
  sessions              Session[]   // many-to-many with Session
  lessons               Lesson[]
  staffPreferredGroups  StaffPreferredGroup[]
  handoverLogs          HandoverLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model HandoverLog {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  groupId          String
  group            Group             @relation(fields: [groupId], references: [id])
  handoverDate     DateTime          @db.Date
  status           HandoverLogStatus @default(DRAFT)
  currentContentJson Json
  createdByUserId  String
  createdByUser    User              @relation("HandoverLogCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId String?
  approvedByUser   User?             @relation("HandoverLogApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  versions         HandoverLogVersion[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, groupId, handoverDate])
  @@index([tenantId, handoverDate])
  @@index([tenantId, groupId])
  @@index([status])
}

model HandoverLogVersion {
  id                  String       @id @default(uuid())
  handoverLogId       String
  handoverLog         HandoverLog  @relation(fields: [handoverLogId], references: [id], onDelete: Cascade)
  versionNumber       Int
  contentSnapshotJson Json
  editedByUserId      String
  editedByUser        User         @relation("HandoverLogVersionEditedBy", fields: [editedByUserId], references: [id])
  editedAt            DateTime     @default(now())
  changeSummary       String?
  diffJson            Json?

  @@index([handoverLogId, versionNumber])
}

model Attendance {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])
  present   Boolean
  timestamp DateTime @default(now())

  @@index([childId])
  @@index([sessionId])
  @@index([groupId])
}

// summary/details are encrypted at rest — see packages/db/src/pii-encryption.ts.
model Concern {
  id        String    @id @default(uuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id])
  summary   String
  details   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([childId])
}

model Session {
  id                    String                   @id @default(uuid())
  tenantId              String
  tenant                Tenant                   @relation(fields: [tenantId], references: [id])
  groups                Group[]                  // many-to-many: session can be for multiple classes
  startsAt              DateTime
  endsAt                DateTime
  title                 String?
  assignments           Assignment[]
  attendances           Attendance[]
  lessons               Lesson[]                 // lessons linked to this session
  sessionStaffAttendance SessionStaffAttendance[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([tenantId])
  @@index([startsAt])
}

model Assignment {
  id           String           @id @default(uuid())
  sessionId    String
  session      Session          @relation(fields: [sessionId], references: [id])
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  role         Role
  status       AssignmentStatus @default(CONFIRMED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  swapRequests SwapRequest[]    @relation("AssignmentSwapRequests")

  @@unique([sessionId, userId, role])
  @@index([userId])
}

model SessionStaffAttendance {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  sessionId      String
  session        Session               @relation(fields: [sessionId], references: [id])
  staffUserId    String
  staffUser      User                  @relation("StaffAttendanceForUser", fields: [staffUserId], references: [id])
  status         StaffAttendanceStatus @default(UNKNOWN)
  markedByUserId String?
  markedByUser   User?                 @relation("StaffAttendanceMarkedBy", fields: [markedByUserId], references: [id])
  markedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([tenantId, sessionId, staffUserId])
  @@index([tenantId])
  @@index([sessionId])
  @@index([staffUserId])
}

model VolunteerPreference {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  weekday     Weekday
  startMinute Int // minutes from 00:00 (0-1439)
  endMinute   Int // minutes from 00:00 (1-1440)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, tenantId, weekday, startMinute, endMinute])
  @@index([tenantId])
}

model StaffUnavailableDate {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, date])
  @@index([tenantId])
  @@index([userId])
}

model StaffPreferredGroup {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  groupId   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, groupId])
  @@index([tenantId])
  @@index([userId])
}

model SwapRequest {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation("AssignmentSwapRequests", fields: [assignmentId], references: [id])
  fromUserId   String
  fromUser     User       @relation("SwapFromUser", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?      @relation("SwapToUser", fields: [toUserId], references: [id])
  status       SwapStatus @default(REQUESTED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
}

model Lesson {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  groupId            String?
  group              Group?    @relation(fields: [groupId], references: [id])
  sessionId          String?   // optional link to a session (replaces date-only association)
  session            Session?  @relation(fields: [sessionId], references: [id])
  title              String
  description        String?
  fileKey            String?   // Supabase Storage key / label for resource
  resourceFileBytes  Bytes?    // Inline fallback until storage backfill
  resourceFileName   String?   // original filename for download
  weekOf             DateTime  // e.g., Monday of the week (kept for backward compatibility)
  createdAt          DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([groupId])
  @@index([sessionId])
  @@index([weekOf])
}

model Subject {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  name         String
  category     String?
  color        String?
  isActive     Boolean       @default(true)
  sortOrder    Int?
  learningLogs LearningLog[]
  subjectEnrollments StudentSubjectEnrollment[]
  paceAssessments PaceAssessment[]
  paceProgress PaceProgress[]
  pacePolicyOverrides PacePolicyOverride[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model AcademicYear {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  name      String
  startsOn  DateTime           @db.Date
  endsOn    DateTime           @db.Date
  status    AcademicYearStatus @default(ACTIVE)
  periods   AcademicPeriod[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, status, startsOn])
}

model AcademicPeriod {
  id             String               @id @default(uuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  academicYearId String
  academicYear   AcademicYear         @relation(fields: [academicYearId, tenantId], references: [id, tenantId])
  name           String
  startsOn       DateTime             @db.Date
  endsOn         DateTime             @db.Date
  status         AcademicPeriodStatus @default(ACTIVE)
  aceTermReports AceTermReport[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, status, startsOn])
}

model AceTermReport {
  id               String   @id @default(uuid())
  tenantId         String
  childId          String
  academicPeriodId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  child          Child                  @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  academicPeriod AcademicPeriod         @relation(fields: [academicPeriodId, tenantId], references: [id, tenantId], onDelete: Restrict)
  compilations   AceReportCompilation[]
  drafts         AceReportDraft[]
  versions       AceTermReportVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, childId, academicPeriodId])
  @@index([tenantId, academicPeriodId, childId])
}

model AceReportCompilation {
  id               String   @id @default(uuid())
  tenantId         String
  reportId         String
  sourceEncrypted  String   @db.Text
  compiledByUserId String
  compiledAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report     AceTermReport    @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  compiledBy User             @relation("AceReportCompilationCompiledBy", fields: [compiledByUserId], references: [id], onDelete: Restrict)
  drafts     AceReportDraft[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, reportId])
  @@index([tenantId, reportId, compiledAt])
}

model AceReportDraft {
  id                  String               @id @default(uuid())
  tenantId            String
  reportId            String
  compilationId       String
  familyPayload       Json
  staffNotesEncrypted String?              @db.Text
  status              AceReportDraftStatus @default(DRAFT)
  authorUserId        String
  submittedAt         DateTime?
  approvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report           AceTermReport         @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  compilation      AceReportCompilation  @relation(fields: [compilationId, tenantId, reportId], references: [id, tenantId, reportId], onDelete: Restrict)
  author           User                  @relation("AceReportDraftAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  reviews          AceReportReview[]
  publishedVersion AceTermReportVersion? @relation("AceReportVersionSourceDraft")

  @@unique([id, tenantId])
  @@unique([id, tenantId, reportId])
  @@index([tenantId, reportId, status, createdAt])
  @@index([tenantId, authorUserId])
}

model AceReportReview {
  id                   String                  @id @default(uuid())
  tenantId             String
  draftId              String
  reviewerUserId       String
  decision             AceReportReviewDecision
  reviewNotesEncrypted String?                 @db.Text
  createdAt            DateTime                @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  draft    AceReportDraft @relation(fields: [draftId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewer User           @relation("AceReportReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, draftId, createdAt])
  @@index([tenantId, reviewerUserId])
}

model AceTermReportVersion {
  id                  String   @id @default(uuid())
  tenantId            String
  reportId            String
  sourceDraftId       String
  versionNumber       Int
  familyPayload       Json
  privateDocumentKey  String?
  guardianVisibleAt   DateTime
  studentVisibleAt    DateTime?
  supersedesVersionId String?
  createdAt           DateTime @default(now())

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report            AceTermReport         @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceDraft       AceReportDraft         @relation("AceReportVersionSourceDraft", fields: [sourceDraftId, tenantId, reportId], references: [id, tenantId, reportId], onDelete: Restrict)
  supersedesVersion AceTermReportVersion?  @relation("AceReportVersionSupersession", fields: [supersedesVersionId, tenantId, reportId], references: [id, tenantId, reportId], onDelete: Restrict)
  supersededBy      AceTermReportVersion? @relation("AceReportVersionSupersession")

  @@unique([id, tenantId])
  @@unique([id, tenantId, reportId])
  @@unique([sourceDraftId, tenantId, reportId])
  @@unique([supersedesVersionId, tenantId, reportId])
  @@unique([reportId, versionNumber])
  @@index([tenantId, reportId, guardianVisibleAt])
}

model StudentSubjectEnrollment {
  id               String                         @id @default(uuid())
  tenantId         String
  tenant           Tenant                         @relation(fields: [tenantId], references: [id])
  childId          String
  child            Child                          @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId        String
  subject          Subject                        @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  startsOn         DateTime                       @db.Date
  endsOn           DateTime?                      @db.Date
  status           StudentSubjectEnrollmentStatus @default(ACTIVE)
  startingPace     Int
  currentPace      Int
  targetPace       Int
  recordedByUserId String
  recordedBy       User                           @relation("StudentSubjectEnrollmentRecordedBy", fields: [recordedByUserId], references: [id])
  reason           String                         @db.Text
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, subjectId, childId])
}

// Immutable assessment facts. Corrections are complete successor facts linked
// to the immediately preceding fact; database constraints prevent forks.
model PaceAssessment {
  id                    String               @id @default(uuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  childId               String
  child                 Child                @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId             String
  subject               Subject              @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  paceNumber            Int
  assessmentType        PaceAssessmentType
  score                 Int
  result                PaceAssessmentResult
  assessedOn            DateTime             @db.Date
  recordedByUserId      String
  recordedBy            User                 @relation("PaceAssessmentRecordedBy", fields: [recordedByUserId], references: [id])
  reason                String               @db.Text
  policyOverrideId      String?
  policyOverride        PacePolicyOverride?  @relation(fields: [policyOverrideId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict)
  correctsAssessmentId  String?
  correctsAssessment    PaceAssessment?      @relation("PaceAssessmentCorrections", fields: [correctsAssessmentId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict, onUpdate: Restrict, map: "PaceAssessment_correction_target_fkey")
  correction            PaceAssessment?      @relation("PaceAssessmentCorrections")
  progressUsingAsLatest PaceProgress[]
  createdAt             DateTime             @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId])
  @@unique([correctsAssessmentId, tenantId, childId, subjectId], map: "PaceAssessment_correction_target_key")
  @@unique([policyOverrideId, tenantId])
  @@index([tenantId, childId, subjectId, assessedOn])
  @@index([tenantId, correctsAssessmentId])
}

// Mutable, disposable projection rebuilt from the current (not superseded)
// PaceAssessment facts.
model PaceProgress {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  childId          String
  child            Child           @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId        String
  subject          Subject         @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  currentPace      Int
  targetPace       Int
  completedPaces   Int             @default(0)
  trackStatus      PaceTrackStatus
  blockCode        String?
  lastAssessmentId String?
  lastAssessment   PaceAssessment? @relation(fields: [lastAssessmentId, tenantId, childId, subjectId], references: [id, tenantId, childId, subjectId], onDelete: Restrict)
  rebuiltAt        DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, childId, subjectId])
  @@index([tenantId, childId])
  @@index([tenantId, trackStatus])
}

// Append-only policy versions. The effective version is selected by time.
model PacePolicy {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  version              Int
  selfTestPassingScore Int
  paceTestPassingScore Int
  maxAssessmentsPerDay Int
  allowSamePaceSameDay Boolean              @default(false)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  createdByUserId      String
  createdBy            User                 @relation("PacePolicyCreatedBy", fields: [createdByUserId], references: [id])
  reason               String               @db.Text
  overrides            PacePolicyOverride[]
  createdAt            DateTime             @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
}

model PacePolicyOverride {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  childId            String
  child              Child            @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId          String
  subject            Subject          @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  pacePolicyId       String
  pacePolicy         PacePolicy       @relation(fields: [pacePolicyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  policyCode         String
  authorisedByUserId String
  authorisedBy       User             @relation("PacePolicyOverrideAuthorisedBy", fields: [authorisedByUserId], references: [id])
  reason             String           @db.Text
  expiresAt          DateTime         // PostgreSQL also rejects non-finite timestamps.
  assessments        PaceAssessment[]
  createdAt          DateTime         @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, subjectId])
  @@index([tenantId, childId, expiresAt])
  @@index([tenantId, subjectId, expiresAt])
}

// note is sensitive free text encrypted transparently by packages/db/src/pii-encryption.ts.
// Corrections use the same complete-fact successor pattern as PaceAssessment.
model BehaviourEntry {
  id                       String              @id @default(uuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id])
  childId                  String
  child                    Child               @relation(fields: [childId, tenantId], references: [id, tenantId])
  type                     BehaviourType
  visibility               BehaviourVisibility @default(GENERAL)
  category                 String
  pointsDelta              Int                 @default(0)
  occurredAt               DateTime
  recordedByUserId         String
  recordedBy               User                @relation("BehaviourEntryRecordedBy", fields: [recordedByUserId], references: [id])
  reason                   String              @db.Text
  note                     String?             @db.Text
  correctsBehaviourEntryId String?
  correctsBehaviourEntry   BehaviourEntry?     @relation("BehaviourEntryCorrections", fields: [correctsBehaviourEntryId, tenantId, childId], references: [id, tenantId, childId], onDelete: Restrict, onUpdate: Restrict, map: "BehaviourEntry_correction_target_fkey")
  correction               BehaviourEntry?     @relation("BehaviourEntryCorrections")
  createdAt                DateTime            @default(now())

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId])
  @@unique([correctsBehaviourEntryId, tenantId, childId], map: "BehaviourEntry_correction_target_key")
  @@index([tenantId, childId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, correctsBehaviourEntryId])
}

model DemeritPolicy {
  id                     String                 @id @default(uuid())
  tenantId               String
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  version                Int
  windowDays             Int
  stageOneThreshold      Int
  stageTwoThreshold      Int
  stageThreeThreshold    Int
  seriousMisconductStage Int
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  createdByUserId        String
  createdBy              User                   @relation("DemeritPolicyCreatedBy", fields: [createdByUserId], references: [id])
  reason                 String                 @db.Text
  stageOverrides         DemeritStageOverride[]
  createdAt              DateTime               @default(now())

  @@unique([id, tenantId])
  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
}

model DemeritStageOverride {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  childId            String
  child              Child         @relation(fields: [childId, tenantId], references: [id, tenantId])
  demeritPolicyId    String
  demeritPolicy      DemeritPolicy @relation(fields: [demeritPolicyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stage              Int
  authorisedByUserId String
  authorisedBy       User          @relation("DemeritStageOverrideAuthorisedBy", fields: [authorisedByUserId], references: [id])
  reason             String        @db.Text
  expiresAt          DateTime        // PostgreSQL also rejects non-finite timestamps.
  createdAt          DateTime      @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, childId, expiresAt])
}

model LearningLog {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  childId        String
  child          Child      @relation(fields: [childId, tenantId], references: [id, tenantId])
  subjectId      String?
  subject        Subject?   @relation(fields: [subjectId, tenantId], references: [id, tenantId])
  loggedByUserId String
  loggedBy       User       @relation("LearningLogLoggedBy", fields: [loggedByUserId], references: [id])
  activityDate   DateTime   @db.Date
  minutes        Int?
  title          String
  description    String?    @db.Text
  evidence       Evidence[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId, activityDate])
  @@index([tenantId, childId, activityDate])
  @@index([subjectId])
  @@unique([id, tenantId])
}

model Evidence {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  childId          String
  child            Child        @relation(fields: [childId, tenantId], references: [id, tenantId])
  learningLogId    String?
  learningLog      LearningLog? @relation(fields: [learningLogId, tenantId], references: [id, tenantId])
  title            String
  storageKey       String
  mimeType         String
  byteSize         Int
  capturedAt       DateTime?
  uploadedByUserId String
  uploadedBy       User         @relation("EvidenceUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([tenantId, childId])
  @@index([learningLogId])
}

model ReportBundle {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  childId           String?
  child             Child?             @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User               @relation("ReportBundleRequestedBy", fields: [requestedByUserId], references: [id])
  periodStart       DateTime           @db.Date
  periodEnd         DateTime           @db.Date
  status            ReportBundleStatus @default(PENDING)
  storageKey        String?
  failureReason     String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([tenantId, childId])
  @@index([status])
}

model Announcement {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([publishedAt])
  @@index([tenantId, audience, publishedAt])
}

// text is encrypted at rest — see packages/db/src/pii-encryption.ts.
model ChildNote {
  id               String    @id @default(uuid())
  childId          String
  child            Child     @relation(fields: [childId], references: [id])
  authorId         String
  author           User      @relation("ChildNoteAuthor", fields: [authorId], references: [id])
  text             String
  visibleToParents Boolean   @default(false)
  approvedByUserId String?
  approvedBy       User?     @relation("ChildNoteApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([childId])
  @@index([authorId])
}

model AuditEvent {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now())
  tenantId    String?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id])
  orgId       String
  org         Org             @relation(fields: [orgId], references: [id])
  actorUserId String
  actor       User            @relation("AuditActor", fields: [actorUserId], references: [id])
  entityType  AuditEntityType
  entityId    String?
  action      AuditAction
  metadata    Json?

  @@index([tenantId, createdAt])
  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

// --- Billing & Entitlements ---

model Subscription {
  id                String             @id @default(uuid())
  orgId             String
  org               Org                @relation(fields: [orgId], references: [id])
  provider          BillingProvider
  providerSubId     String             @unique
  planCode          String
  status            SubscriptionStatus
  periodStart       DateTime
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orgId])
  @@index([status])
  @@index([planCode])
}

model OrgEntitlementSnapshot {
  id                  String   @id @default(uuid())
  orgId               String
  org                 Org      @relation(fields: [orgId], references: [id])
  maxSites            Int
  av30Included        Int
  leaderSeatsIncluded Int
  storageGbIncluded   Int
  flagsJson           Json?
  source              String // e.g., trial, subscription(pro), manual_override
  createdAt           DateTime @default(now())

  @@index([orgId, createdAt])
}

model UsageCounters {
  id           String   @id @default(uuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  av30         Int      @default(0)
  storageGb    Int      @default(0)
  smsMonth     Int      @default(0)
  exportsMonth Int      @default(0)
  calculatedAt DateTime @default(now())

  @@index([orgId, calculatedAt])
}

model BillingEvent {
  id          String          @id @default(uuid())
  orgId       String?
  org         Org?            @relation(fields: [orgId], references: [id])
  provider    BillingProvider
  type        String
  payloadJson Json
  createdAt   DateTime        @default(now())

  @@index([orgId, createdAt])
}

model PendingOrder {
  id                     String             @id @default(uuid())
  tenantId               String?
  tenant                 Tenant?            @relation(fields: [tenantId], references: [id])
  orgId                  String?
  org                    Org?               @relation(fields: [orgId], references: [id])
  planCode               String
  av30Cap                Int?
  storageGbCap           Int?
  smsMessagesCap         Int?
  leaderSeatsIncluded    Int?
  maxSites               Int?
  selectedModules        Module[]           @default([])
  flags                  Json?
  warnings               Json?
  provider               BillingProvider
  providerCheckoutId     String?
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 PendingOrderStatus @default(PENDING)
  createdAt              DateTime           @default(now())
  completedAt            DateTime?
  updatedAt              DateTime           @updatedAt
  
  // For public checkout: store org/user details until payment confirmed.
  // Encrypted as a whole (may carry a plaintext password transiently) — see
  // packages/db/src/pii-encryption.ts. { orgName, slug, contactName, contactEmail, password }
  pendingOrgDetails      Json?

  @@index([tenantId, orgId, provider, providerCheckoutId])
  @@index([provider, providerSubscriptionId])
}

model OrgRetentionPolicy {
  id                         String   @id @default(uuid())
  orgId                      String   @unique
  org                        Org      @relation(fields: [orgId], references: [id])
  attendanceRetentionDays    Int
  staffActivityRetentionDays Int
  auditEventRetentionDays    Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model StaffActivity {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  staffUserId  String
  staffUser    User     @relation(fields: [staffUserId], references: [id])
  activityType String // Av30ActivityType enum value
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, staffUserId, occurredAt])
  @@index([orgId, occurredAt])
  @@index([orgId, staffUserId, occurredAt])
}

model Lead {
  id             String    @id @default(uuid())
  kind           LeadKind
  email          String
  name           String?
  organisation   String?
  role           String?
  sector         String?
  message        String?   @db.Text
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  metadataJson   Json?
  downloadedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  downloadTokens DownloadToken[]

  @@index([email, kind, createdAt])
  @@index([kind, createdAt])
}

model DownloadToken {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tokenHash])
  @@index([tokenHash])
  @@index([leadId])
}
