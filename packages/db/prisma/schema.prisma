  updatedAt              DateTime                @updatedAt

  @@unique([id, orgId])
  @@index([orgId])
}

model UserTenantRole {
  id       String @id @default(uuid())
  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role])
}

// NEW: User ↔ Org roles (optional, for suite-level administration)
model UserOrgRole {
  id     String  @id @default(uuid())
  userId String
  orgId  String
  role   OrgRole

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId, role])
  @@index([orgId])
}

model User {
  id                String    @id @default(uuid())
  email             String?   @unique
  name              String?
  displayName       String?
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime? @db.Date
  avatarUrl         String? // External URL fallback (e.g. Auth0)
  avatarKey         String? // Supabase Storage key for uploaded avatar
  avatarBytes       Bytes? // Inline fallback until storage backfill
  avatarContentType String? // e.g. image/jpeg
  isActive          Boolean   @default(true)
  superUser         Boolean   @default(false) // Nexsteps staff only (e.g. blog admin)

  // NOTE: kept for backward compatibility (single-tenant user). For suites, prefer UserTenantRole.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Preferred site (tenant) remembered by the API when multiple memberships exist.
  lastActiveTenantId String?
  lastActiveTenant   Tenant? @relation("UserLastActiveTenant", fields: [lastActiveTenantId], references: [id])

  children                          Child[]                     @relation("ParentChildren")
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  firstLoginAt                      DateTime? // Track when user first logs in (for onboarding)
  hasServeAccess                    Boolean                     @default(false)
  hasFamilyAccess                   Boolean                     @default(false)
  roles                             UserTenantRole[]
  siteMemberships                   SiteMembership[]
  orgMemberships                    OrgMembership[]
  assignments                       Assignment[]
  preferences                       VolunteerPreference[]
  notes                             ChildNote[]                 @relation("ChildNoteAuthor")
  approvedNotes                     ChildNote[]                 @relation("ChildNoteApprovedBy")
  auditEvents                       AuditEvent[]                @relation("AuditActor")
  swapRequestsFrom                  SwapRequest[]               @relation("SwapFromUser")
  swapRequestsTo                    SwapRequest[]               @relation("SwapToUser")
  orgRoles                          UserOrgRole[]
  staffActivities                   StaffActivity[]
  identities                        UserIdentity[]
  guardianIdentities                GuardianIdentity[]
  studentIdentities                 StudentIdentity[]
  revokedStudentIdentityLinks       StudentIdentityLink[]       @relation("StudentIdentityLinkRevokedBy")
  revokedGuardianChildRelationships GuardianChildRelationship[] @relation("GuardianChildRelationshipRevokedBy")
  familyIdentityInvites FamilyIdentityInvite[] @relation("FamilyIdentityInviteUser")
  familyIdentityInvitesCreated FamilyIdentityInvite[] @relation("FamilyIdentityInviteCreatedBy")
  familyIdentityInvitesRevoked FamilyIdentityInvite[] @relation("FamilyIdentityInviteRevokedBy")
  invitesCreated          Invite[]                  @relation("InviteCreatedBy")
  publicSignupLinksCreated PublicSignupLink[]       @relation("PublicSignupLinkCreatedBy")
  orgDeletionRecords    OrgDeletedUser[]          @relation("OrgDeletedUserTarget")
  deletedOrgUsers       OrgDeletedUser[]          @relation("OrgDeletedUserActor")
  staffUnavailableDates   StaffUnavailableDate[]
  staffPreferredGroups    StaffPreferredGroup[]
  emergencyContacts       EmergencyContact[]
  parentSignupConsents    ParentSignupConsent[]
  staffAttendanceAsStaff  SessionStaffAttendance[] @relation("StaffAttendanceForUser")
  staffAttendanceMarkedBy SessionStaffAttendance[] @relation("StaffAttendanceMarkedBy")
  handoverLogsCreated     HandoverLog[]           @relation("HandoverLogCreatedBy")
  handoverLogsApproved    HandoverLog[]           @relation("HandoverLogApprovedBy")
  handoverLogVersions     HandoverLogVersion[]    @relation("HandoverLogVersionEditedBy")
  loggedLearningLogs      LearningLog[]           @relation("LearningLogLoggedBy")
  uploadedEvidence        Evidence[]              @relation("EvidenceUploadedBy")
  paceInventoryOrdersCreated PaceInventoryOrder[] @relation("PaceInventoryOrderCreatedBy")
  paceInventorySuppliesCreated PaceInventorySupply[] @relation("PaceInventorySupplyCreatedBy")
  paceDiagnosticResultsRecorded PaceDiagnosticResult[] @relation("PaceDiagnosticResultRecordedBy")
  paceDiagnosticRetractionsRecorded PaceDiagnosticRetraction[] @relation("PaceDiagnosticRetractionRecordedBy")
  requestedReportBundles  ReportBundle[]          @relation("ReportBundleRequestedBy")
  requestedDataExports    DataExportRequest[]      @relation("DataExportRequestRequestedBy")
  requestedAccountDeletions AccountDeletionRequest[] @relation("AccountDeletionRequestRequestedBy")
  createdActivities       Activity[]              @relation("ActivityCreatedBy")
  assignedTasks           Task[]                  @relation("TaskAssignedTo")
  createdTasks            Task[]                  @relation("TaskCreatedBy")
  createdCalendarItems    CalendarItem[]          @relation("CalendarItemCreatedBy")
  updatedHouseholdRequirements HouseholdRequirement[] @relation("HouseholdRequirementUpdatedBy")
  linkedEvidenceLinks     EvidenceLink[]          @relation("EvidenceLinkLinkedBy")
  createdCorrespondence   Correspondence[]        @relation("CorrespondenceCreatedBy")
  recordedSubjectEnrollments StudentSubjectEnrollment[] @relation("StudentSubjectEnrollmentRecordedBy")
  recordedPaceAssessments    PaceAssessment[]            @relation("PaceAssessmentRecordedBy")
  aceYearBandAssignments     AceStaffYearBandAssignment[]
  createdPacePolicies        PacePolicy[]                @relation("PacePolicyCreatedBy")
  authorisedPaceOverrides    PacePolicyOverride[]        @relation("PacePolicyOverrideAuthorisedBy")
  recordedBehaviourEntries  BehaviourEntry[]            @relation("BehaviourEntryRecordedBy")
  correctedAttendance       Attendance[]                 @relation("AttendanceCorrectedBy")
  attendanceCorrectionEvents AttendanceCorrectionEvent[] @relation("AttendanceCorrectionEventRecordedBy")
  aceDailyAttendanceRecorded AceDailyAttendance[] @relation("AceDailyAttendanceRecordedBy")
  aceDailyCorrectionsRecorded AceDailyAttendanceCorrectionEvent[] @relation("AceDailyCorrectionRecordedBy")
  createdBehaviourCategories BehaviourCategory[]         @relation("BehaviourCategoryCreatedBy")
  createdDemeritPolicies     DemeritPolicy[]             @relation("DemeritPolicyCreatedBy")
  authorisedDemeritOverrides DemeritStageOverride[]      @relation("DemeritStageOverrideAuthorisedBy")
  compiledAceReports          AceReportCompilation[]      @relation("AceReportCompilationCompiledBy")
  authoredAceReportDrafts     AceReportDraft[]            @relation("AceReportDraftAuthor")
  reviewedAceReports          AceReportReview[]           @relation("AceReportReviewReviewer")
  authoredFaithContentDrafts  FaithContentDraft[]          @relation("FaithContentDraftAuthor")
  releasedFaithReflections    FaithReflection[]            @relation("FaithReflectionReleasedBy")
  tripsCreated                Trip[]                       @relation("TripCreatedBy")
  tripsCancelled              Trip[]                       @relation("TripCancelledBy")
  tripCheckpointsCreated      TripCheckpoint[]             @relation("TripCheckpointCreatedBy")
  tripAttendanceMarked        TripCheckpointAttendance[]   @relation("TripCheckpointAttendanceMarkedBy")
  permissionSlipsCreated      PermissionSlip[]             @relation("PermissionSlipCreatedBy")
  permissionSlipVersionsCreated PermissionSlipVersion[]     @relation("PermissionSlipVersionCreatedBy")
  permissionSlipVersionsPublished PermissionSlipVersion[]   @relation("PermissionSlipVersionPublishedBy")
  permissionSlipExceptionsRecorded PermissionSlipException[] @relation("PermissionSlipExceptionRecordedBy")
  permissionSlipExceptionsWitnessed PermissionSlipException[] @relation("PermissionSlipExceptionWitness")
  aceCommunityGroupsCreated       AceCommunityGroup[]              @relation("AceCommunityGroupCreatedBy")
  aceCommunityGroupStaffMemberships AceCommunityGroupStaffMember[] @relation("AceCommunityGroupStaffMember")
  aceCommunityPosts               AceCommunityPost[]               @relation("AceCommunityPostAuthor")
  aceCommunityReplies             AceCommunityReply[]              @relation("AceCommunityReplyAuthor")
  aceCommunityReadCursors         AceCommunityReadCursor[]         @relation("AceCommunityReadCursorUser")
  aceCommunityReports             AceCommunityReport[]             @relation("AceCommunityReportReporter")
  aceCommunityModerationActions   AceCommunityModerationAction[]   @relation("AceCommunityModerationActionModerator")
  createdMessageConversations       MessageConversation[]          @relation("MessageConversationCreatedBy")
  messageParticipants               MessageParticipant[]           @relation("MessageParticipantUser")
  createdAceNotices                 AceNotice[]                    @relation("AceNoticeCreatedBy")
  aceNoticeAudienceMemberships      AceNoticeAudienceMember[]      @relation("AceNoticeAudienceRecipient")
  roleAssignments         UserRoleAssignment[]    @relation("UserRoleAssignmentAssignee")
  roleAssignmentsGranted  UserRoleAssignment[]    @relation("UserRoleAssignmentAssignedBy")
  roleAssignmentsRevoked  UserRoleAssignment[]    @relation("UserRoleAssignmentRevokedBy")
  accessTagGrants         AccessTagGrant[]        @relation("AccessTagGrantAssignee")
  accessTagGrantsIssued   AccessTagGrant[]        @relation("AccessTagGrantor")
  accessTagGrantsRevoked  AccessTagGrant[]        @relation("AccessTagGrantRevoker")
}

// Auth identity linking external providers (e.g., Auth0) to internal users.
model UserIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  email           String?
  displayName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject])
  @@index([userId])
}

// A global user may be a guardian in more than one tenant. The identity does
// not itself grant data access; GuardianChildRelationship is the access fact.
model GuardianIdentity {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  relationships   GuardianChildRelationship[]
  acceptedInvites FamilyIdentityInvite[]      @relation("FamilyIdentityInviteAcceptedGuardian")
  messageConversations     MessageConversation[]
  messageParticipants      MessageParticipant[]
  aceNoticeAudienceMembers AceNoticeAudienceMember[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@unique([id, tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// A global user may represent a student only inside a tenant. Student access
// additionally requires an active StudentIdentityLink and enabled tenant policy.
model StudentIdentity {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  links           StudentIdentityLink[]
  acceptedInvites FamilyIdentityInvite[] @relation("FamilyIdentityInviteAcceptedStudent")
  faithReadReceipts FaithReadReceipt[]
  faithReflections  FaithReflection[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@unique([id, tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// One tenant-owned portal setting controls whether new active student links can
// be created. It is intentionally one row per tenant rather than an id record.
model StudentPortalPolicy {
  tenantId             String   @id
  studentPortalEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StudentIdentityLink {
  id                String    @id @default(uuid())
  tenantId          String
  studentIdentityId String
  childId           String
  linkedAt          DateTime  @default(now())
  endedAt           DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  revocationReason  String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentIdentity StudentIdentity @relation(fields: [studentIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child           Child           @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revokedBy       User?           @relation("StudentIdentityLinkRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, childId])
  @@index([tenantId, studentIdentityId])
}

model GuardianChildRelationship {
  id                 String              @id @default(uuid())
  tenantId           String
  guardianIdentityId String
  childId            String
  legalAccess        GuardianLegalAccess @default(FULL)
  startsAt           DateTime            @default(now())
  endedAt            DateTime?
  revokedAt          DateTime?
  revokedByUserId    String?
  revocationReason   String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianIdentity        GuardianIdentity         @relation(fields: [guardianIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  child                   Child                    @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revokedBy               User?                    @relation("GuardianChildRelationshipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  permissionSlipResponses PermissionSlipResponse[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, childId, guardianIdentityId])
  @@index([tenantId, childId])
  @@index([tenantId, guardianIdentityId])
}

// Invitation lifecycle only. A later command service delivers the invite and
// creates the separate guardian relationship or student link after acceptance.
model FamilyIdentityInvite {
  id                         String               @id @default(uuid())
  tenantId                   String
  invitedUserId              String
  target                     FamilyIdentityTarget
  childId                    String?
  createdByUserId            String
  expiresAt                  DateTime
  acceptedAt                 DateTime?
  acceptedGuardianIdentityId String?
  acceptedStudentIdentityId  String?
  revokedAt                  DateTime?
  revokedByUserId            String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedUser              User              @relation("FamilyIdentityInviteUser", fields: [invitedUserId], references: [id], onDelete: Restrict)
  child                    Child?            @relation(fields: [childId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy                User              @relation("FamilyIdentityInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy                User?             @relation("FamilyIdentityInviteRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  acceptedGuardianIdentity GuardianIdentity? @relation("FamilyIdentityInviteAcceptedGuardian", fields: [acceptedGuardianIdentityId, tenantId, invitedUserId], references: [id, tenantId, userId], onDelete: Restrict)
  acceptedStudentIdentity  StudentIdentity?  @relation("FamilyIdentityInviteAcceptedStudent", fields: [acceptedStudentIdentityId, tenantId, invitedUserId], references: [id, tenantId, userId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, invitedUserId, createdAt])
  @@index([tenantId, childId])
  @@index([expiresAt])
}

// Membership of a user to an Org (suite-level). Useful for listing sites the user can manage.
model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole  @default(ORG_MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

// Membership of a user to a Site (Tenant). This is the primary tenant access control.
model SiteMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      SiteRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

// Invite model for onboarding new users to Orgs and Sites
model Invite {
  id              String  @id @default(uuid())
  orgId           String
  org             Org     @relation(fields: [orgId], references: [id])
  createdByUserId String
  createdBy       User    @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  email           String // normalized to lowercase
  name            String? // Optional name for the invitee

  // Org-level role (optional, if granting org access)
  orgRole OrgRole?

  // Site-level access (optional, if granting site access)
  siteIdsJson String? // JSON array of site IDs ["site1", "site2"]
  siteRole    SiteRole?

  // Token and expiry
  tokenHash String   @unique // Store hash only, never raw token
  expiresAt DateTime

  // Lifecycle timestamps
  usedAt     DateTime?
  revokedAt  DateTime?
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, email])
  @@index([tokenHash])
  @@index([email])
}

model OrgDeletedUser {
  id              String   @id @default(uuid())
  orgId           String
  userId          String
  deletedByUserId String
  name            String
  displayName     String?
  email           String?
  priorOrgRole    OrgRole?
  priorSiteCount  Int      @default(0)
  deletedAt       DateTime @default(now())

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User @relation("OrgDeletedUserTarget", fields: [userId], references: [id])
  deletedBy User @relation("OrgDeletedUserActor", fields: [deletedByUserId], references: [id])

  @@index([orgId, deletedAt])
  @@index([userId])
  @@index([deletedByUserId])
}

// Invite-only public parent signup link (site-specific; token in QR link).
// tokenForDisplay: stored only for admin re-display of the same QR; never logged; verification uses tokenHash only.
model PublicSignupLink {
  id              String    @id @default(uuid())
  orgId           String
  tenantId        String
  tokenHash       String
  tokenForDisplay String? // For returning same signup URL to admin; never log or expose outside admin response
  createdByUserId String?
  createdBy       User?     @relation("PublicSignupLinkCreatedBy", fields: [createdByUserId], references: [id])
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org    Org    @relation(fields: [orgId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, revokedAt, expiresAt])
  @@index([orgId])
}

// Emergency contact for a parent (guardian) in a tenant.
// name/phone/relationship are encrypted at rest — see packages/db/src/pii-encryption.ts.
model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// Consent record for parent signup (timestamps + consenting adult identity).
// consentingAdultName/consentingAdultRelationship are encrypted at rest — see packages/db/src/pii-encryption.ts.
model ParentSignupConsent {
  id                          String    @id @default(uuid())
  userId                      String
  tenantId                    String
  dataProcessingConsentAt     DateTime
  firstAidConsentAt           DateTime?
  consentingAdultName         String
  consentingAdultRelationship String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// fullName/phone/relationshipToChild are encrypted at rest — see packages/db/src/pii-encryption.ts.
model ChildGuardianContact {
  id                      String                   @id @default(uuid())
  childId                 String
  tenantId                String
  fullName                String
  email                   String?
  phone                   String?
  relationshipToChild     String?
  contactType             ChildGuardianContactType @default(PRIMARY_GUARDIAN)
  dataProcessingConsentAt DateTime?
  firstAidConsentAt       DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([tenantId])
  @@index([tenantId, contactType])
}

// allergies/additionalNeedsNotes/gpName/gpPhone/specialNeedsOther/notes are encrypted
// at rest — see packages/db/src/pii-encryption.ts. dateOfBirth is NOT yet encrypted
// (would require a DateTime -> String column change; tracked as a follow-up).
model Child {
  id                         String                      @id @default(uuid())
  firstName                  String
  lastName                   String
  preferredName              String?
  dateOfBirth                DateTime?
  allergies                  String                      @default("unknown")
  additionalNeedsNotes       String?
  // Safeguarding-relevant info from public signup
  schoolName                 String?
  yearGroup                  String?
  gpName                     String?
  gpPhone                    String?
  specialNeedsType           String? // e.g. none, sen_support, ehcp, other
  specialNeedsOther          String? // Free text when specialNeedsType is "other"
  photoConsent               Boolean                     @default(false)
  photoKey                   String?
  photoBytes                 Bytes? // Inline fallback until storage backfill
  photoContentType           String? // e.g. image/jpeg
  notes                      String?
  tenantId                   String
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  guardians                  User[]                      @relation("ParentChildren")
  guardianContacts           ChildGuardianContact[]
  groupId                    String?
  group                      Group?                      @relation(fields: [groupId], references: [id])
  disabilities               String[]                    @default([])
  concerns                   Concern[]
  attendance                 Attendance[]
  attendanceCorrectionEvents AttendanceCorrectionEvent[]
  aceDailyAttendance         AceDailyAttendance[]
  childNotes                 ChildNote[]
  learningLogs               LearningLog[]
  aceSchoolEnrollments       AceSchoolEnrollment[]
  subjectEnrollments         StudentSubjectEnrollment[]
  paceAssessments            PaceAssessment[]
  paceProgress               PaceProgress[]
  paceDiagnosticResults      PaceDiagnosticResult[]
  paceInventoryOrders        PaceInventoryOrder[]
  paceInventorySupplies      PaceInventorySupply[]
  pacePolicyOverrides        PacePolicyOverride[]
  behaviourEntries           BehaviourEntry[]
  demeritStageOverrides      DemeritStageOverride[]
  studentIdentityLinks       StudentIdentityLink[]
  guardianChildRelationships GuardianChildRelationship[]
  familyIdentityInvites      FamilyIdentityInvite[]
  aceTermReports             AceTermReport[]
  evidence                   Evidence[]
  reportBundles              ReportBundle[]
  activities                 Activity[]
  householdRequirements      HouseholdRequirement[]
  correspondence             Correspondence[]
  tripCheckpointAttendance   TripCheckpointAttendance[]
  permissionSlipRecipients   PermissionSlipRecipient[]
  permissionSlipResponses    PermissionSlipResponse[]
  permissionSlipExceptions   PermissionSlipException[]
  permissionSlipReminders    PermissionSlipReminder[]
  aceCommunityGroupMemberships AceCommunityGroupChildMember[]
  // Guest pass (day visitor): auto-deleted by the workers guest-pass-cleanup sweep
  // ~1h after guestExpiresAt. See docs/design/guest-pass-24h.md.
  isGuest                    Boolean                     @default(false)
  guestExpiresAt             DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([isGuest, guestExpiresAt])
}

model Group {
  id                   String                @id @default(uuid())
  name                 String
  minAge               Int?
  maxAge               Int?
  description          String?
  color                String? // Hex color for rota/schedule cards (e.g. #0ec2a2)
  isActive             Boolean               @default(true)
  sortOrder            Int?
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  children             Child[]
  attendances          Attendance[]
  sessions             Session[] // many-to-many with Session
  lessons              Lesson[]
  staffPreferredGroups StaffPreferredGroup[]
  handoverLogs         HandoverLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ACE Student Community is school-owned and intentionally separate from both
// academic groups and NexSteps Home Community.
model AceCommunityPolicy {
  tenantId         String   @id
  communityEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AceCommunityGroup {
  id             String                          @id @default(uuid())
  tenantId       String
  name           String
  description    String?                         @db.Text
  membershipMode AceCommunityGroupMembershipMode
  minimumAge     Int?
  maximumAge     Int?
  isActive       Boolean                         @default(true)
  createdByUserId String
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy         User                            @relation("AceCommunityGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  childMembers      AceCommunityGroupChildMember[]
  staffMembers      AceCommunityGroupStaffMember[]
  posts             AceCommunityPost[]
  replies           AceCommunityReply[]
  readCursors       AceCommunityReadCursor[]
  reports           AceCommunityReport[]
  moderationActions AceCommunityModerationAction[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, membershipMode])
}

model AceCommunityGroupChildMember {
