  author User              @relation("AceCommunityReplyAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  reports AceCommunityReport[] @relation("AceCommunityReportReply")

  @@unique([id, tenantId])
  @@unique([id, tenantId, groupId])
  @@index([tenantId, groupId, postId, createdAt])
  @@index([tenantId, authorUserId, createdAt])
}

model AceCommunityReadCursor {
  id         String   @id @default(uuid())
  tenantId   String
  groupId    String
