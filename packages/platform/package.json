{
  "name": "@pathway/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./capability-definitions": "./src/capability-definitions.ts",
    "./capability-maps": "./src/capability-maps.ts",
    "./access-tags": "./src/access-tags.ts",
    "./finance-currencies": "./src/finance-currencies.ts",
    "./finance-collection-amount": "./src/finance-collection-amount.ts",
    "./messaging/realtime-connection": "./src/messaging/message-realtime-connection.ts"
  },
  "scripts": {
    "build": "echo platform-build",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.config.ts --runInBand",
    "permission-definitions:sync": "tsx scripts/sync-permission-definitions.ts",
    "permission-definitions:check": "tsx scripts/check-permission-definitions.ts",
    "backfill:org-vertical": "tsx scripts/backfill-org-vertical.ts"
  },
  "dependencies": {
    "@pathway/db": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
