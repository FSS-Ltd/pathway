{
  "expo": {
    "name": "Nexsteps",
    "slug": "nexsteps-mobile",
    "scheme": "nexsteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./pathwayLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./pathwayLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f6f8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexsteps.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./pathwayLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nexsteps.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-auth0",
        {
          "domain": "${AUTH0_MOBILE_DOMAIN}",
          "customScheme": "nexsteps"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "${EXPO_PUBLIC_API_URL}",
      "auth0Domain": "${AUTH0_MOBILE_DOMAIN}",
      "auth0ClientId": "${AUTH0_MOBILE_CLIENT_ID}",
      "auth0Audience": "${AUTH0_MOBILE_AUDIENCE}",
      "auth0Scope": "${AUTH0_MOBILE_SCOPE}",
      "auth0CustomScheme": "${AUTH0_MOBILE_CUSTOM_SCHEME}"
    }
  }
}
