{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm --filter @pathway/api build",
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/internal/notice-schedules/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/message-email/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/homework-schedules/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/homework-email/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/faith-schedules/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/permission-slip-schedules/run",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "{dist/serverless/**,node_modules/@prisma/client/{index.js,default.js,package.json,runtime/**},../../packages/db/prisma/schema.prisma,../../node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/client/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/[...path].js?__vercel_path=$path"
    },
    {
      "src": "/(?<path>.*)",
      "dest": "/api/[...path].js?__vercel_path=$path"
    }
  ]
}
