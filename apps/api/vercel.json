{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm --filter @pathway/api build",
  "regions": ["lhr1"],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "{api/package.json,tsconfig.json,src/**,../../packages/{auth,db,platform,types,util}/src/**,../../packages/{auth,db,platform,types,util}/package.json,../../packages/config/{package.json,tsconfig/**},../../packages/db/prisma/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/[...path].js?__vercel_path=$path"
    },
    {
      "src": "/(?<path>.*)",
      "dest": "/api/[...path].js?__vercel_path=$path"
    }
  ]
}
