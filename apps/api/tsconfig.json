{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "../../",
    "outDir": "../../apps/api/dist",
    "paths": {
      "@pathway/auth": ["../../packages/auth/src/index.ts"],
      "@pathway/auth/*": ["../../packages/auth/src/*"],
      "@pathway/ace-domain": ["../../packages/ace-domain/src/index.ts"],
      "@pathway/ace-domain/*": ["../../packages/ace-domain/src/*"],
      "@pathway/db": ["../../packages/db/src/index.ts"],
      "@pathway/db/*": ["../../packages/db/src/*"],
      "@pathway/platform": ["../../packages/platform/src/index.ts"],
      "@pathway/platform/*": ["../../packages/platform/src/*"],
      "@pathway/pricing": ["../../packages/pricing/src/index.ts"],
      "@pathway/pricing/*": ["../../packages/pricing/src/*"],
      "@pathway/types": ["../../packages/types/src/index.ts"],
      "@pathway/types/*": ["../../packages/types/src/*"],
      "@pathway/util": ["../../packages/util/src/index.ts"],
      "@pathway/util/*": ["../../packages/util/src/*"]
    }
  },
  "include": [
    "api",
    "src",
    "scripts",
    "../../packages/auth/src",
    "../../packages/ace-domain/src",
    "../../packages/db/src",
    "../../packages/platform/src",
    "../../packages/pricing/src",
    "../../packages/types/src",
    "../../packages/util/src"
  ],
  "exclude": ["../../packages/**/__tests__/**"]
}
