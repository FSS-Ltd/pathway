{
  "name": "@pathway/nexsteps-home",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"fidelity/**/*.{ts,mjs}\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --config jest.config.js",
    "test:fidelity": "tsx fidelity/run.ts"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@pathway/mobile-core": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~54.0.0",
    "expo-constants": "^55.0.9",
    "expo-font": "^55.0.4",
    "expo-router": "~6.0.0",
    "expo-secure-store": "^55.0.9",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-auth0": "^5.4.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.13.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2"
  }
